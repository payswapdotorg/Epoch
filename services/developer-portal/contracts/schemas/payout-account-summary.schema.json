{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PayoutAccountSummary",
  "$defs": {
    "PayoutAccountSummary": {
      "readOnly": true,
      "title": "PayoutAccountSummary",
      "description": "The developer tenant's adopted W024 billing-account summary (where marketplace revenue settles): account id, settlement currency, display name, opening instant, and content digest.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "accountId": {
          "type": "string",
          "pattern": "^billing-account:[a-z0-9][a-z0-9-]{0,54}$"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "openedAt": {
          "type": "string"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "schemaVersion",
        "accountId",
        "currency",
        "displayName",
        "openedAt",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "title": "CurrencyCode",
      "description": "ISO 4217 currency code (three uppercase letters)."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:developer-portal:payout-account-summary:1.0.0"
}
