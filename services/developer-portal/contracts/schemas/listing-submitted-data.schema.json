{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "listingId": {
      "$ref": "#/$defs/ListingId"
    }
  },
  "required": [
    "listingId"
  ],
  "additionalProperties": false,
  "$defs": {
    "ListingId": {
      "type": "string",
      "pattern": "^listing:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ListingId",
      "description": "Opaque marketplace listing identity: \"listing:\" followed by a lowercase slug (stable across versions)."
    }
  },
  "$id": "urn:epoch:developer-portal:listing-submitted-data:1.0.0"
}
