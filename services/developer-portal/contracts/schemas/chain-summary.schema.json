{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChainSummary",
  "$defs": {
    "ChainSummary": {
      "readOnly": true,
      "title": "ChainSummary",
      "description": "The verified publication-chain summary of one developer listing: sealed version count and the head pin (the W023 kernel chain verification projected).",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "listingId": {
          "$ref": "#/$defs/ListingId"
        },
        "versionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "headVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "headDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "schemaVersion",
        "listingId",
        "versionCount",
        "headVersion",
        "headDigest"
      ],
      "additionalProperties": false
    },
    "ListingId": {
      "type": "string",
      "pattern": "^listing:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ListingId",
      "description": "Opaque marketplace listing identity: \"listing:\" followed by a lowercase slug (stable across versions)."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:developer-portal:chain-summary:1.0.0"
}
