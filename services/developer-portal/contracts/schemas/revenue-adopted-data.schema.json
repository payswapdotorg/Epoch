{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "revenueId": {
      "type": "string",
      "pattern": "^revenue:[a-z0-9][a-z0-9-]{0,62}$"
    },
    "listingId": {
      "$ref": "#/$defs/ListingId"
    },
    "amount": {
      "$ref": "#/$defs/NonNegativeDecimal"
    },
    "currency": {
      "$ref": "#/$defs/CurrencyCode"
    }
  },
  "required": [
    "revenueId",
    "listingId",
    "amount",
    "currency"
  ],
  "additionalProperties": false,
  "$defs": {
    "ListingId": {
      "type": "string",
      "pattern": "^listing:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ListingId",
      "description": "Opaque marketplace listing identity: \"listing:\" followed by a lowercase slug (stable across versions)."
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "title": "CurrencyCode",
      "description": "ISO 4217 currency code (three uppercase letters)."
    }
  },
  "$id": "urn:epoch:developer-portal:revenue-adopted-data:1.0.0"
}
