        "../../packages/agent-orchestration/src/index.ts"
      ],
      "@epoch/authorization": [
        "../../packages/authorization/src/index.ts"
      ],
      "@epoch/contracts-constraints": [
        "../../contracts/constraints/v1/index.ts"
      ],
      "@epoch/document-adapter": [
        "../../packages/document-adapter/src/index.ts"
      ],
      "@epoch/event-log": [
        "../../packages/event-log/src/index.ts"
      ],
      "@epoch/evidence": [
        "../../packages/evidence/src/index.ts"
