        "../../packages/solution-delivery/src/index.ts"
      ],
      "@epoch/tenancy": [
        "../../packages/tenancy/src/index.ts"
      ],
      "@epoch/variance": [
        "../../packages/variance/src/index.ts"
      ],
      "@epoch/world-contracts": [
        "../../contracts/world/src/index.ts"
