{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PackBreakdown",
  "$defs": {
    "PackBreakdown": {
      "readOnly": true,
      "title": "PackBreakdown",
      "description": "One per-domain-pack breakdown slice: the pack id, the row/direction counts, and the exact total absolute deviation of that pack rows.",
      "type": "object",
      "properties": {
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "overCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "underCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "exactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "totalAbsoluteDeviation": {
          "$ref": "#/$defs/NonNegativeDecimal"
        }
      },
      "required": [
        "packId",
        "rowCount",
        "overCount",
        "underCount",
        "exactCount",
        "totalAbsoluteDeviation"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    }
  },
  "$id": "urn:epoch:learning-calibration:pack-breakdown:1.0.0"
}
