{
  "$id": "urn:epoch:contracts:world:provenance:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:contracts:world:provenance",
  "$defs": {
    "urn:epoch:contracts:world:provenance": {
      "readOnly": true,
      "title": "Provenance",
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/urn:epoch:contracts:world:actor-ref"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/urn:epoch:contracts:world:evidence-ref"
          }
        },
        "derivedFrom": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/urn:epoch:contracts:world:assertion-id"
          }
        },
        "recordedVia": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "actor",
        "method",
        "evidence"
      ],
      "additionalProperties": false
    },
    "urn:epoch:contracts:world:actor-ref": {
      "readOnly": true,
      "title": "ActorRef",
      "description": "Opaque, provider-neutral actor reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "external-provider",
            "sensor",
            "importer"
          ]
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "urn:epoch:contracts:world:evidence-ref": {
      "readOnly": true,
      "title": "EvidenceRef",
      "description": "Addressable evidence reference (opaque id); evidence bytes are never embedded.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "enum": [
            "document",
            "measurement",
            "observation",
            "computation",
            "assertion",
            "external",
            "other"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,128}$"
        },
        "locator": {
          "type": "string",
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "urn:epoch:contracts:world:assertion-id": {
      "type": "string",
      "pattern": "^ass-[0-9]+$",
      "title": "AssertionId"
    }
  }
}
