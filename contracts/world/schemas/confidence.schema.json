{
  "$id": "urn:epoch:contracts:world:confidence:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:contracts:world:confidence",
  "$defs": {
    "urn:epoch:contracts:world:confidence": {
      "readOnly": true,
      "title": "Confidence",
      "type": "object",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/urn:epoch:contracts:world:confidence-distribution"
        },
        "method": {
          "type": "string",
          "enum": [
            "stated",
            "measured",
            "estimated",
            "derived",
            "imported"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "distribution"
      ],
      "additionalProperties": false
    },
    "urn:epoch:contracts:world:confidence-distribution": {
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "point"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "interval"
            },
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bias": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "high"
              ]
            }
          },
          "required": [
            "kind",
            "lower",
            "upper"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set"
            },
            "values": {
              "readOnly": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "weights": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        }
      ],
      "title": "ConfidenceDistribution"
    }
  }
}
