{
  "$id": "urn:epoch:contracts:world:validity:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:contracts:world:validity",
  "$defs": {
    "urn:epoch:contracts:world:validity": {
      "readOnly": true,
      "title": "Validity",
      "description": "Temporal validity interval; from is inclusive, to is exclusive.",
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/urn:epoch:contracts:world:instant"
        },
        "to": {
          "$ref": "#/$defs/urn:epoch:contracts:world:instant"
        }
      },
      "additionalProperties": false
    },
    "urn:epoch:contracts:world:instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "title": "Instant",
      "description": "RFC 3339 UTC instant with Z suffix (e.g. 2026-02-05T12:00:00.000Z)."
    }
  }
}
