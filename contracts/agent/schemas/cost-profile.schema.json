{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CostProfile",
  "$defs": {
    "CostProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "per-proposal"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "basis",
            "currency",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "per-session"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "basis",
            "currency",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "per-hour"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "basis",
            "currency",
            "amount"
          ],
          "additionalProperties": false
        }
      ],
      "title": "CostProfile",
      "description": "Neutral cost declaration; amounts are non-negative decimal strings with ISO 4217 currency codes."
    }
  }
}
