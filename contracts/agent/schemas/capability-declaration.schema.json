{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityDeclaration",
  "$defs": {
    "CapabilityDeclaration": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "protocolVersion",
        "capabilityId",
        "summary",
        "domain",
        "inputs",
        "outputs",
        "assumptions"
      ],
      "additionalProperties": false,
      "title": "CapabilityDeclaration",
      "description": "Provider-neutral declaration of a capability: namespaced id, domain, parameter specs, and stated assumptions."
    },
    "ProtocolVersion": {
      "type": "string",
      "const": "1.0.0",
      "title": "ProtocolVersion",
      "description": "Exact agent-protocol version admitted by this release (\"1.0.0\")."
    },
    "ParameterSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "enumValues": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "kind",
        "required",
        "description"
      ],
      "additionalProperties": false,
      "title": "ParameterSpec",
      "description": "Named capability parameter with value kind, optionality, and description."
    },
    "ParameterKind": {
      "type": "string",
      "enum": [
        "integer",
        "number",
        "string",
        "boolean",
        "enum",
        "entity-reference",
        "json"
      ],
      "title": "ParameterKind",
      "description": "Value kind of a capability parameter."
    }
  }
}
