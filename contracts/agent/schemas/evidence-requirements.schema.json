{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidenceRequirements",
  "$defs": {
    "EvidenceRequirements": {
      "type": "object",
      "properties": {
        "requiresRationale": {
          "type": "boolean"
        },
        "requiresPredictedEffects": {
          "type": "boolean"
        },
        "requiresEvidenceRefs": {
          "type": "boolean"
        },
        "requiredArtifactKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "required": [
        "requiresRationale",
        "requiresPredictedEffects",
        "requiresEvidenceRefs",
        "requiredArtifactKinds"
      ],
      "additionalProperties": false,
      "title": "EvidenceRequirements",
      "description": "What evidence an agent must attach to action proposals (rationale, predicted effects, references, artifact kinds)."
    }
  }
}
