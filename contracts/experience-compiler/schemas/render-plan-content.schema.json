{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RenderPlanContent",
  "$defs": {
    "RenderPlanContent": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "epoch.render-plan"
        },
        "protocolVersion": {
          "$ref": "#/$defs/RenderPlanProtocolVersion"
        },
        "sourceGraphId": {
          "$ref": "#/$defs/ExperienceGraphId"
        },
        "sourceGraphKind": {
          "$ref": "#/$defs/ExperienceGraphKind"
        },
        "sourceEnvelopeDigest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "tenantScope": {
          "$ref": "#/$defs/TenantScope"
        },
        "sourceRefs": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedReference"
          }
        },
        "target": {
          "$ref": "#/$defs/DeviceDescriptor"
        },
        "constraints": {
          "$ref": "#/$defs/PlanConstraints"
        },
        "usage": {
          "$ref": "#/$defs/RenderPlanUsage"
        },
        "stages": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStage"
          }
        }
      },
      "required": [
        "schema",
        "protocolVersion",
        "sourceGraphId",
        "sourceGraphKind",
        "sourceEnvelopeDigest",
        "tenantScope",
        "sourceRefs",
        "target",
        "constraints",
        "usage",
        "stages"
      ],
      "additionalProperties": false,
      "title": "RenderPlanContent",
      "description": "The content of a Render Plan envelope: chain to the source graph revision, tenant scope, target device, derived constraints, resource usage, and the staged compiled body."
    },
    "RenderPlanProtocolVersion": {
      "type": "string",
      "const": "1.0.0",
      "title": "RenderPlanProtocolVersion",
      "description": "Exact render-plan protocol version admitted by this release (\"1.0.0\")."
    },
    "ExperienceGraphId": {
      "type": "string",
      "pattern": "^xg-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ExperienceGraphId",
      "description": "Experience-graph identifier: \"xg-\" followed by a lowercase slug."
    },
    "ExperienceGraphKind": {
      "type": "string",
      "enum": [
        "2d",
        "3d",
        "animation",
        "narrative",
        "timeline-replay",
        "presence",
        "controls"
      ],
      "title": "ExperienceGraphKind",
      "description": "Presentation projection of an Experience Graph: 2D, 3D, animation, narrative, timeline/replay, presence, or controls."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "TenantScope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "workspaceId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "projectId": {
          "$ref": "#/$defs/OpaqueScopeId"
        }
      },
      "required": [
        "tenantId"
      ],
      "additionalProperties": false,
      "title": "TenantScope",
      "description": "Tenant scoping of an experience document: owning tenant, optional workspace and project narrowing."
    },
    "OpaqueScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "OpaqueScopeId",
      "description": "Opaque scoping identifier (tenant/workspace/project/participant); bounded, neutral charset."
    },
    "ProjectedReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectedWorldEntityRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldRelationRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldEventRef"
        },
        {
          "$ref": "#/$defs/ProjectedAgentRef"
        },
        {
          "$ref": "#/$defs/ProjectedEvidenceRef"
        },
        {
          "$ref": "#/$defs/ProjectedCapabilityRef"
        }
      ],
      "title": "ProjectedReference",
      "description": "Opaque, tenant-scoped, exact-revision reference to projected kernel state; never an embedded kernel object."
    },
    "ProjectedWorldEntityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-entity"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "entityId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:entity-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "entityId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEntityRef",
      "description": "Exact-revision reference to a materialized world-model entity (W002 grammar; digest of its canonical JSON)."
    },
    "urn:epoch:contracts:world:entity-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "EntityId",
      "description": "Opaque entity identity (graph node), caller-assigned."
    },
    "ProjectedWorldRelationRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-relation"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "relationId": {
          "$ref": "#/$defs/WorldRelationId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "relationId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldRelationRef",
      "description": "Exact-revision reference to a materialized world-model relation (W002 grammar; digest of its canonical JSON)."
    },
    "WorldRelationId": {
      "type": "string",
      "pattern": "^rel-[0-9a-f]{64}$",
      "title": "WorldRelationId",
      "description": "World-model relation identity: rel-<sha256-of-key> (owned by @epoch/world-model)."
    },
    "ProjectedWorldEventRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-event"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "eventId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:event-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "eventId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEventRef",
      "description": "Exact-revision reference to a world-model event (W002 grammar; digest of its canonical JSON)."
    },
    "urn:epoch:contracts:world:event-id": {
      "type": "string",
      "pattern": "^evt-[0-9]+$",
      "title": "EventId"
    },
    "ProjectedAgentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "agentId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedAgentRef",
      "description": "Exact-revision reference to a registered agent (W003 grammar; digest of its registration canonical JSON)."
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AgentId",
      "description": "Registered agent identifier: \"agent:\" followed by a lowercase slug."
    },
    "ProjectedEvidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "evidence-record"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "recordDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "recordDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedEvidenceRef",
      "description": "Reference to an evidence record by its content-addressed identity (W006: the SHA-256 digest is the id)."
    },
    "ProjectedCapabilityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "capability"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "capabilityId",
        "capabilityVersion",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedCapabilityRef",
      "description": "Exact-revision reference to a registered capability manifest (W007 grammar; digest of its canonical JSON)."
    },
    "DeviceDescriptor": {
      "type": "object",
      "properties": {
        "descriptorVersion": {
          "type": "number",
          "const": 1
        },
        "deviceClass": {
          "$ref": "#/$defs/DeviceClass"
        },
        "interaction": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "display": {
          "$ref": "#/$defs/DeviceDisplayCapabilities"
        },
        "spatial": {
          "$ref": "#/$defs/DeviceSpatialCapabilities"
        },
        "latencyBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "descriptorVersion",
        "deviceClass",
        "interaction",
        "display",
        "spatial"
      ],
      "additionalProperties": false,
      "title": "DeviceDescriptor",
      "description": "Abstract, provider-neutral device descriptor: capabilities and budgets as typed data; filled/adapted by renderer/device adaptation (W019)."
    },
    "DeviceClass": {
      "type": "string",
      "enum": [
        "desktop",
        "laptop",
        "tablet",
        "phone",
        "headset",
        "wall-display"
      ],
      "title": "DeviceClass",
      "description": "Neutral device class of a device descriptor (never a vendor product)."
    },
    "InteractionModality": {
      "type": "string",
      "enum": [
        "gamepad",
        "gaze",
        "gesture",
        "keyboard",
        "pointer",
        "touch",
        "voice"
      ],
      "title": "InteractionModality",
      "description": "Neutral interaction modality of a device."
    },
    "DeviceDisplayCapabilities": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stereoscopic"
      ],
      "additionalProperties": false,
      "title": "DeviceDisplayCapabilities",
      "description": "Neutral display capabilities and budgets of a device descriptor."
    },
    "DeviceSpatialCapabilities": {
      "type": "object",
      "properties": {
        "poseTracking": {
          "$ref": "#/$defs/PoseTrackingKind"
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poseTracking",
        "worldAnchored"
      ],
      "additionalProperties": false,
      "title": "DeviceSpatialCapabilities",
      "description": "Neutral spatial capabilities and budgets of a device descriptor."
    },
    "PoseTrackingKind": {
      "type": "string",
      "enum": [
        "none",
        "3dof",
        "6dof"
      ],
      "title": "PoseTrackingKind",
      "description": "Neutral pose-tracking capability of a device."
    },
    "PlanConstraints": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "poseTracking": {
          "$ref": "#/$defs/PoseTrackingKind"
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "interaction": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "latencyBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stereoscopic",
        "poseTracking",
        "worldAnchored",
        "interaction"
      ],
      "additionalProperties": false,
      "title": "PlanConstraints",
      "description": "The typed plan constraints: target-device budgets and limits as data (device-aware plan shaping)."
    },
    "RenderPlanUsage": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedTriangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assetBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodes",
        "edges",
        "estimatedTriangles",
        "assetBytes"
      ],
      "additionalProperties": false,
      "title": "RenderPlanUsage",
      "description": "Deterministic resource accounting of the compiled plan: exact node/edge counts, primitive-triangle estimate, and mesh-asset bytes."
    },
    "PlanStage": {
      "oneOf": [
        {
          "$ref": "#/$defs/RelateStage"
        },
        {
          "$ref": "#/$defs/Draw2dStage"
        },
        {
          "$ref": "#/$defs/Place3dStage"
        },
        {
          "$ref": "#/$defs/AnimateStage"
        },
        {
          "$ref": "#/$defs/NarrateStage"
        },
        {
          "$ref": "#/$defs/TimelineStage"
        },
        {
          "$ref": "#/$defs/PresenceStage"
        },
        {
          "$ref": "#/$defs/ControlsStage"
        }
      ],
      "title": "PlanStage",
      "description": "One compiled plan stage of the deterministic pipeline: relate, draw-2d, place-3d, animate, narrate, timeline, presence, or controls."
    },
    "RelateStage": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "const": "relate"
        },
        "relations": {
          "minItems": 1,
          "maxItems": 8192,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanRelation"
          }
        }
      },
      "required": [
        "stage",
        "relations"
      ],
      "additionalProperties": false,
      "title": "RelateStage",
      "description": "The relate stage: the plan relation set (present iff the source graph has edges)."
    },
    "PlanRelation": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExperienceEdgeKind"
        },
        "from": {
          "$ref": "#/$defs/ExperienceNodeId"
        },
        "to": {
          "$ref": "#/$defs/ExperienceNodeId"
        },
        "attributes": {
          "$ref": "#/$defs/PresentationAttributes"
        }
      },
      "required": [
        "kind",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "title": "PlanRelation",
      "description": "One experience edge carried into the plan, verbatim and canonically ordered."
    },
    "ExperienceEdgeKind": {
      "type": "string",
      "enum": [
        "anchors",
        "animates",
        "binds-control",
        "contains",
        "follows",
        "synchronizes"
      ],
      "title": "ExperienceEdgeKind",
      "description": "Typed relationship kind between two Experience Graph nodes."
    },
    "ExperienceNodeId": {
      "type": "string",
      "pattern": "^xn-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ExperienceNodeId",
      "description": "Experience-local node identifier: \"xn-\" followed by a lowercase slug."
    },
    "PresentationAttributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "PresentationAttributes",
      "description": "Presentation-only open attribute record (never kernel semantics; reserved keys are rejected at admission)."
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Draw2dStage": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "const": "draw-2d"
        },
        "draws": {
          "minItems": 1,
          "maxItems": 4096,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanDrawOp"
          }
        }
      },
      "required": [
        "stage",
        "draws"
      ],
      "additionalProperties": false,
      "title": "Draw2dStage",
      "description": "The draw-2d stage: z-ordered 2D draw operations."
    },
    "PlanDrawOp": {
      "oneOf": [
        {
          "$ref": "#/$defs/PlanDrawShapeOp"
        },
        {
          "$ref": "#/$defs/PlanDrawLabelOp"
        }
      ],
      "title": "PlanDrawOp",
      "description": "One compiled 2D draw operation: shape or label."
    },
    "PlanDrawShapeOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "draw-shape"
        },
        "nodeId": {
          "$ref": "#/$defs/ExperienceNodeId"
        },
        "ref": {
          "$ref": "#/$defs/ProjectedReference"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry2d"
        },
        "stroke": {
          "$ref": "#/$defs/StrokeStyle2d"
        },
        "fill": {
          "$ref": "#/$defs/FillStyle2d"
        },
        "zIndex": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "attributes": {
          "$ref": "#/$defs/PresentationAttributes"
        }
      },
      "required": [
        "op",
        "nodeId",
        "geometry"
      ],
      "additionalProperties": false,
      "title": "PlanDrawShapeOp",
      "description": "Compiled 2D draw operation: neutral geometry, resolved styling, and inherited presentation attributes."
    },
    "Geometry2d": {
      "oneOf": [
        {
          "$ref": "#/$defs/Geometry2dPoint"
        },
        {
          "$ref": "#/$defs/Geometry2dRect"
        },
        {
          "$ref": "#/$defs/Geometry2dCircle"
        },
        {
          "$ref": "#/$defs/Geometry2dEllipse"
        },
        {
          "$ref": "#/$defs/Geometry2dPolyline"
        },
        {
          "$ref": "#/$defs/Geometry2dPolygon"
        }
      ],
      "title": "Geometry2d",
      "description": "Neutral 2D geometry: point, rect, circle, ellipse, polyline, or polygon."
    },
    "Geometry2dPoint": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "const": "point"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "form",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Geometry2dPoint"
    },
    "Geometry2dRect": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "const": "rect"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "form",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "title": "Geometry2dRect"
    },
    "Geometry2dCircle": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "const": "circle"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "r": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "form",
        "cx",
        "cy",
        "r"
      ],
      "additionalProperties": false,
      "title": "Geometry2dCircle"
    },
    "Geometry2dEllipse": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "const": "ellipse"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "rx": {
          "type": "number",
          "minimum": 0
        },
        "ry": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "form",
        "cx",
        "cy",
