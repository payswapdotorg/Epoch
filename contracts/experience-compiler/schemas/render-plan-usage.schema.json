{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RenderPlanUsage",
  "$defs": {
    "RenderPlanUsage": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedTriangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assetBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodes",
        "edges",
        "estimatedTriangles",
        "assetBytes"
      ],
      "additionalProperties": false,
      "title": "RenderPlanUsage",
      "description": "Deterministic resource accounting of the compiled plan: exact node/edge counts, primitive-triangle estimate, and mesh-asset bytes."
    }
  }
}
