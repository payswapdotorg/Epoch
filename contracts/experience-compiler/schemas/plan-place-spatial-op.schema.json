{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PlanPlaceSpatialOp",
  "$defs": {
    "PlanPlaceSpatialOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "place-spatial"
        },
        "nodeId": {
          "$ref": "#/$defs/ExperienceNodeId"
        },
        "ref": {
          "$ref": "#/$defs/ProjectedReference"
        },
        "primitive": {
          "$ref": "#/$defs/SpatialPrimitive"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        },
        "scale": {
          "$ref": "#/$defs/PlanScale3d"
        },
        "mesh": {
          "$ref": "#/$defs/MeshBinding"
        },
        "attributes": {
          "$ref": "#/$defs/PresentationAttributes"
        }
      },
      "required": [
        "op",
        "nodeId",
        "primitive",
        "position"
      ],
      "additionalProperties": false,
      "title": "PlanPlaceSpatialOp",
      "description": "Compiled 3D placement operation: neutral primitive, resolved transform, optional content-addressed mesh."
    },
    "ExperienceNodeId": {
      "type": "string",
      "pattern": "^xn-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ExperienceNodeId",
      "description": "Experience-local node identifier: \"xn-\" followed by a lowercase slug."
    },
    "ProjectedReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectedWorldEntityRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldRelationRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldEventRef"
        },
        {
          "$ref": "#/$defs/ProjectedAgentRef"
        },
        {
          "$ref": "#/$defs/ProjectedEvidenceRef"
        },
        {
          "$ref": "#/$defs/ProjectedCapabilityRef"
        }
      ],
      "title": "ProjectedReference",
      "description": "Opaque, tenant-scoped, exact-revision reference to projected kernel state; never an embedded kernel object."
    },
    "ProjectedWorldEntityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-entity"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "entityId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:entity-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "entityId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEntityRef",
      "description": "Exact-revision reference to a materialized world-model entity (W002 grammar; digest of its canonical JSON)."
    },
    "OpaqueScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "OpaqueScopeId",
      "description": "Opaque scoping identifier (tenant/workspace/project/participant); bounded, neutral charset."
    },
    "urn:epoch:contracts:world:entity-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "EntityId",
      "description": "Opaque entity identity (graph node), caller-assigned."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "ProjectedWorldRelationRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-relation"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "relationId": {
          "$ref": "#/$defs/WorldRelationId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "relationId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldRelationRef",
      "description": "Exact-revision reference to a materialized world-model relation (W002 grammar; digest of its canonical JSON)."
    },
    "WorldRelationId": {
      "type": "string",
      "pattern": "^rel-[0-9a-f]{64}$",
      "title": "WorldRelationId",
      "description": "World-model relation identity: rel-<sha256-of-key> (owned by @epoch/world-model)."
    },
    "ProjectedWorldEventRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-event"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "eventId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:event-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "eventId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEventRef",
      "description": "Exact-revision reference to a world-model event (W002 grammar; digest of its canonical JSON)."
    },
    "urn:epoch:contracts:world:event-id": {
      "type": "string",
      "pattern": "^evt-[0-9]+$",
      "title": "EventId"
    },
    "ProjectedAgentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "agentId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedAgentRef",
      "description": "Exact-revision reference to a registered agent (W003 grammar; digest of its registration canonical JSON)."
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AgentId",
      "description": "Registered agent identifier: \"agent:\" followed by a lowercase slug."
    },
    "ProjectedEvidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "evidence-record"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "recordDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "recordDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedEvidenceRef",
      "description": "Reference to an evidence record by its content-addressed identity (W006: the SHA-256 digest is the id)."
    },
    "ProjectedCapabilityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "capability"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "capabilityId",
        "capabilityVersion",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedCapabilityRef",
      "description": "Exact-revision reference to a registered capability manifest (W007 grammar; digest of its canonical JSON)."
    },
    "SpatialPrimitive": {
      "type": "string",
      "enum": [
        "box",
        "cone",
        "cylinder",
        "mesh",
        "plane",
        "sphere"
      ],
      "title": "SpatialPrimitive",
      "description": "Neutral geometric primitive of a 3D node (mesh binds an opaque content-addressed asset)."
    },
    "Vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "title": "Vec3",
      "description": "Finite 3-component numeric vector (x, y, z)."
    },
    "Quaternion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "title": "Quaternion",
      "description": "Finite orientation quaternion (x, y, z, w); neutral math, renderer-normalized."
    },
    "PlanScale3d": {
      "title": "PlanScale3d",
      "description": "Positive per-axis 3D scale.",
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "MeshBinding": {
      "type": "object",
      "properties": {
        "assetDigest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}\\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}$"
        }
      },
      "required": [
        "assetDigest"
      ],
      "additionalProperties": false,
      "title": "MeshBinding",
      "description": "Content-addressed mesh-asset binding: SHA-256 digest plus optional neutral metadata (no filenames, URLs, or engine formats)."
    },
    "PresentationAttributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "PresentationAttributes",
      "description": "Presentation-only open attribute record (never kernel semantics; reserved keys are rejected at admission)."
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
