{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidenceReference",
  "$defs": {
    "EvidenceReference": {
      "readOnly": true,
      "title": "EvidenceReference",
      "description": "Reference to evidence in the W006 grammar: canonical SHA-256 content digest (exact-revision addressing).",
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "digest"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:solution-delivery:evidence-reference:1.0.0"
}
