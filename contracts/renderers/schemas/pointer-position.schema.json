{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PointerPosition",
  "$defs": {
    "PointerPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "PointerPosition",
      "description": "Normalized pointer position in the renderer viewport: x/y in [0, 1]."
    }
  }
}
