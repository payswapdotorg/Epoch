{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PortableTimelinePosition",
  "$defs": {
    "PortableTimelinePosition": {
      "type": "object",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paused": {
          "type": "boolean"
        },
        "replayWindow": {
          "$ref": "#/$defs/ReplayWindow"
        }
      },
      "required": [
        "atMs",
        "frameIndex",
        "paused"
      ],
      "additionalProperties": false,
      "title": "PortableTimelinePosition",
      "description": "The portable timeline/replay position (mirrored W016 grammar): virtual time, frame index, paused flag, optional replay window."
    },
    "ReplayWindow": {
      "type": "object",
      "properties": {
        "fromSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toSequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fromSequence",
        "toSequence"
      ],
      "additionalProperties": false,
      "title": "ReplayWindow",
      "description": "Bounded world-model event-sequence window for timeline/replay projections (from inclusive, to exclusive)."
    }
  }
}
