{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RendererDescriptor",
  "$defs": {
    "RendererDescriptor": {
      "type": "object",
      "properties": {
        "descriptorVersion": {
          "type": "number",
          "const": 1
        },
        "rendererId": {
          "$ref": "#/$defs/RendererId"
        },
        "graphKinds": {
          "minItems": 1,
          "maxItems": 7,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExperienceGraphKind"
          }
        },
        "interaction": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "output": {
          "$ref": "#/$defs/RendererOutputCapabilities"
        },
        "budgets": {
          "$ref": "#/$defs/RendererBudgets"
        }
      },
      "required": [
        "descriptorVersion",
        "rendererId",
        "graphKinds",
        "interaction",
        "output",
        "budgets"
      ],
      "additionalProperties": false,
      "title": "RendererDescriptor",
      "description": "Abstract, provider-neutral renderer descriptor: hosting kinds, serviced modalities, output capabilities, and budgets as typed data; concrete engines are future adapters."
    },
    "RendererId": {
      "type": "string",
      "pattern": "^rr-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "RendererId",
      "description": "Renderer-descriptor identifier: \"rr-\" followed by a lowercase slug (never a vendor product)."
    },
    "ExperienceGraphKind": {
      "type": "string",
      "enum": [
        "2d",
        "3d",
        "animation",
        "narrative",
        "timeline-replay",
        "presence",
        "controls"
      ],
      "title": "ExperienceGraphKind",
      "description": "Presentation projection of an Experience Graph: 2D, 3D, animation, narrative, timeline/replay, presence, or controls."
    },
    "InteractionModality": {
      "type": "string",
      "enum": [
        "gamepad",
        "gaze",
        "gesture",
        "keyboard",
        "pointer",
        "touch",
        "voice"
      ],
      "title": "InteractionModality",
      "description": "Neutral interaction modality of a device."
    },
    "RendererOutputCapabilities": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 268435456
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 64
        }
      },
      "required": [
        "stereoscopic"
      ],
      "additionalProperties": false,
      "title": "RendererOutputCapabilities",
      "description": "Neutral output capabilities a renderer descriptor declares (never an engine or API surface)."
    },
    "RendererBudgets": {
      "type": "object",
      "properties": {
        "maxGraphNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxGraphEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1099511627776
        }
      },
      "required": [
        "maxGraphNodes",
        "maxGraphEdges"
      ],
      "additionalProperties": false,
      "title": "RendererBudgets",
      "description": "Neutral budgets a renderer descriptor enforces at the hosting boundary."
    }
  }
}
