  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Authored ECL constraint (structured, human-editable, serializable).",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Hard constraint: violation blocks.",
      "properties": {
        "appliesWhen": {
          "$ref": "#/$defs/__schema0",
          "description": "Optional boolean applicability guard; when it evaluates to false the constraint outcome is 'not-applicable'."
        },
        "class": {
          "const": "hard",
          "description": "Must hold; violation blocks.",
          "type": "string"
        },
        "description": {
          "description": "Longer human description.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "description": "Stable, human-readable constraint identifier (lowercase kebab-case).",
          "pattern": "^[a-z][a-z0-9-]{0,127}$",
          "type": "string"
        },
        "inputs": {
          "description": "Declared evaluation-context input slots.",
          "items": {
            "additionalProperties": false,
            "description": "Declared evaluation-context input slot.",
            "properties": {
              "description": {
                "description": "Longer human description.",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "description": "Declared input name referenced by `input` expression nodes.",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$",
                "type": "string"
              },
              "type": {
                "description": "Declared input slot type: number | string | boolean | enum (finite string set) | record (string -> number, e.g. evidence counts) | list (string[], e.g. granted permissions).",
                "enum": [
                  "number",
                  "string",
                  "boolean",
                  "enum",
                  "record",
                  "list"
                ],
                "type": "string"
              },
              "values": {
                "description": "Required iff type is \"enum\": the finite set of allowed strings.",
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 64,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "languageVersion": {
          "const": "1.0.0",
          "description": "ECL language version gate.",
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/__schema0",
          "description": "Boolean expression that must hold."
        },
        "severity": {
          "description": "Optional severity metadata, echoed in evaluation results.",
          "enum": [
            "critical",
            "major",
            "minor"
          ],
          "type": "string"
        },
        "tags": {
          "description": "Free-form classification tags.",
