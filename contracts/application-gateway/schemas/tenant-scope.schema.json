{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TenantScope",
  "$defs": {
    "TenantScope": {
      "readOnly": true,
      "title": "TenantScope",
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/TenantId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "tenantId"
      ],
      "additionalProperties": false
    },
    "TenantId": {
      "type": "string",
      "pattern": "^tenant:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "TenantId",
      "description": "Opaque tenant identity: \"tenant:\" followed by a lowercase slug."
    },
    "WorkspaceId": {
      "type": "string",
      "pattern": "^workspace:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "WorkspaceId",
      "description": "Opaque workspace identity: \"workspace:\" followed by a lowercase slug."
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "ProjectId",
      "description": "Opaque project identity: \"project:\" followed by a lowercase slug."
    }
  },
  "$id": "urn:epoch:application-gateway:tenant-scope:1.0.0"
}
