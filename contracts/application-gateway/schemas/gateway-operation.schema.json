{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GatewayOperation",
  "$defs": {
    "GatewayOperation": {
      "readOnly": true,
      "title": "GatewayOperation",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/GatewayOperationName"
        },
        "kind": {
          "$ref": "#/$defs/GatewayOperationKind"
        },
        "queueable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "name",
        "kind",
        "queueable",
        "description"
      ],
      "additionalProperties": false
    },
    "GatewayOperationName": {
      "type": "string",
      "title": "GatewayOperationName"
    },
    "GatewayOperationKind": {
      "type": "string",
      "enum": [
        "read",
        "mutate"
      ],
      "title": "GatewayOperationKind"
    }
  },
  "$id": "urn:epoch:application-gateway:gateway-operation:1.0.0"
}
