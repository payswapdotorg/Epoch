{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GatewayValidationIssue",
  "$defs": {
    "GatewayValidationIssue": {
      "readOnly": true,
      "title": "GatewayValidationIssue",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:application-gateway:gateway-validation-issue:1.0.0"
}
