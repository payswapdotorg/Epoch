{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LatencyClaim",
  "$defs": {
    "LatencyClaim": {
      "readOnly": true,
      "title": "LatencyClaim",
      "description": "Declared latency characteristics in whole milliseconds (p95 >= p50).",
      "type": "object",
      "properties": {
        "p50Milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p95Milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "p50Milliseconds",
        "p95Milliseconds"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:latency-claim:1.0.0"
}
