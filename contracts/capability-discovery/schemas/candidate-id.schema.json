{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CandidateId",
  "$defs": {
    "CandidateId": {
      "type": "string",
      "pattern": "^cand:[a-z0-9][a-z0-9-]{0,62}$",
