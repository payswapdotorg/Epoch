{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OrganizationEstimates",
  "$defs": {
    "OrganizationEstimates": {
      "readOnly": true,
      "title": "OrganizationEstimates",
      "description": "Rollup estimates for an organization (deterministic sums; null when undeclared).",
      "type": "object",
      "properties": {
        "estimatedLatencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "estimatedCost": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyAmount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimatedLatencyMs",
        "estimatedCost"
      ],
      "additionalProperties": false
    },
    "MoneyAmount": {
      "readOnly": true,
      "title": "MoneyAmount",
      "description": "Cost budget/estimate: ISO 4217 currency code + non-negative decimal amount string.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:organization-estimates:1.0.0"
}
