{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DiscoveryRunTrigger",
  "$defs": {
    "DiscoveryRunTrigger": {
      "readOnly": true,
      "title": "DiscoveryRunTrigger",
      "description": "The trigger record on a run (manual, gap, scheduled, or event).",
      "type": "object",
      "properties": {
        "trigger": {
          "$ref": "#/$defs/DiscoveryTrigger"
        },
        "invokedBy": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "trigger"
      ],
      "additionalProperties": false
    },
    "DiscoveryTrigger": {
      "type": "string",
      "enum": [
        "manual",
        "gap",
        "scheduled",
        "event"
      ],
      "title": "DiscoveryTrigger",
      "description": "What triggered a discovery run: manual, gap, scheduled, or event."
    }
  },
  "$id": "urn:epoch:capability-discovery:discovery-run-trigger:1.0.0"
}
