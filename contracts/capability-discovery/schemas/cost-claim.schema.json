{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CostClaim",
  "$defs": {
    "CostClaim": {
      "readOnly": true,
      "title": "CostClaim",
      "description": "Declared cost characteristics: ISO 4217 currency, decimal amount, neutral basis.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "basis": {
          "type": "string",
          "enum": [
            "per-task",
            "per-hour",
            "per-run",
            "none"
          ]
        }
      },
      "required": [
        "currency",
        "amount",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:cost-claim:1.0.0"
}
