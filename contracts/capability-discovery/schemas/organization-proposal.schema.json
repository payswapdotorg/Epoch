{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OrganizationProposal",
  "$defs": {
    "OrganizationProposal": {
      "readOnly": true,
      "title": "OrganizationProposal",
      "description": "A candidate organization: role bindings, handoff topology, supervision, redundancy, estimates; staged organizations bind unverified candidates and can never be selected.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/CapabilityDiscoveryRecordVersion"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "roleBindings": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrganizationRoleBinding"
          }
        },
        "handoffs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/HandoffEdge"
          }
        },
        "supervision": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupervisionEdge"
          }
        },
        "estimates": {
          "$ref": "#/$defs/OrganizationEstimates"
        },
        "staged": {
          "type": "boolean"
        },
        "stagingReasons": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "schemaVersion",
        "organizationId",
        "label",
        "roleBindings",
        "handoffs",
        "supervision",
        "estimates",
        "staged",
        "stagingReasons"
      ],
      "additionalProperties": false
    },
    "CapabilityDiscoveryRecordVersion": {
      "type": "number",
      "const": 1,
      "title": "CapabilityDiscoveryRecordVersion",
      "description": "Version discriminator carried by every serialized discovery record (currently 1)."
    },
    "OrganizationId": {
      "type": "string",
      "pattern": "^org:[0-9a-f]{16}$",
      "title": "OrganizationId",
      "description": "Content-addressed organization proposal id: \"org:\" + 16 hex characters."
    },
    "OrganizationRoleBinding": {
      "readOnly": true,
      "title": "OrganizationRoleBinding",
      "description": "One role binding inside a candidate organization: primary candidate, backups, carried gaps.",
      "type": "object",
      "properties": {
        "roleProposalId": {
          "$ref": "#/$defs/RoleProposalId"
        },
        "primaryCandidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "backupCandidateIds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateId"
          }
        },
        "carriedGapIds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityGapId"
          }
        }
      },
      "required": [
        "roleProposalId",
        "primaryCandidateId",
        "backupCandidateIds",
        "carriedGapIds"
      ],
      "additionalProperties": false
    },
    "RoleProposalId": {
      "type": "string",
      "pattern": "^drole:[0-9a-f]{16}$",
      "title": "RoleProposalId",
      "description": "Content-addressed role proposal id: \"drole:\" + 16 hex characters."
    },
    "CandidateId": {
      "type": "string",
      "pattern": "^cand:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "CandidateId",
      "description": "Candidate id: \"cand:\" + lowercase slug."
    },
    "CapabilityGapId": {
      "type": "string",
      "pattern": "^gap:[0-9a-f]{16}$",
      "title": "CapabilityGapId",
      "description": "Content-addressed capability gap id: \"gap:\" + 16 hex characters."
    },
    "HandoffEdge": {
      "readOnly": true,
      "title": "HandoffEdge",
      "description": "A handoff edge between two roles (one output feeding one input of a shared representation kind).",
      "type": "object",
      "properties": {
        "fromRoleProposalId": {
          "$ref": "#/$defs/RoleProposalId"
        },
        "toRoleProposalId": {
          "$ref": "#/$defs/RoleProposalId"
        },
        "outputName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "inputName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "kind": {
          "$ref": "#/$defs/RepresentationKind"
        }
      },
      "required": [
        "fromRoleProposalId",
        "toRoleProposalId",
        "outputName",
        "inputName",
        "kind"
      ],
      "additionalProperties": false
    },
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "text",
        "numeric",
        "tabular",
        "geometry",
        "image",
        "signal",
        "document",
        "structured",
        "code"
      ],
      "title": "RepresentationKind",
      "description": "Neutral representation/modality kind: text, numeric, tabular, geometry, image, signal, document, structured, code."
    },
    "SupervisionEdge": {
      "readOnly": true,
      "title": "SupervisionEdge",
      "description": "A supervision/escalation edge attached to a role (human review, peer review, or automated check).",
      "type": "object",
      "properties": {
        "supervisedRoleProposalId": {
          "$ref": "#/$defs/RoleProposalId"
        },
        "escalation": {
          "type": "string",
          "enum": [
            "human-review",
            "peer-review",
            "automated-check"
          ]
        }
      },
      "required": [
        "supervisedRoleProposalId",
        "escalation"
      ],
      "additionalProperties": false
    },
    "OrganizationEstimates": {
      "readOnly": true,
      "title": "OrganizationEstimates",
      "description": "Rollup estimates for an organization (deterministic sums; null when undeclared).",
      "type": "object",
      "properties": {
        "estimatedLatencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "estimatedCost": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyAmount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimatedLatencyMs",
        "estimatedCost"
      ],
      "additionalProperties": false
    },
    "MoneyAmount": {
      "readOnly": true,
      "title": "MoneyAmount",
      "description": "Cost budget/estimate: ISO 4217 currency code + non-negative decimal amount string.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:organization-proposal:1.0.0"
}
