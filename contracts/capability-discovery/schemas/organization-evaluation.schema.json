{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OrganizationEvaluation",
  "$defs": {
    "OrganizationEvaluation": {
      "readOnly": true,
      "title": "OrganizationEvaluation",
      "description": "The evaluation of one candidate organization under declared criteria (hard constraints, objectives, evidence coverage).",
      "type": "object",
      "properties": {
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "criterionResults": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriterionResult"
          }
        },
        "admissible": {
          "type": "boolean"
        },
        "rejectionReasons": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "organizationId",
        "criterionResults",
        "admissible",
        "rejectionReasons",
        "score"
      ],
      "additionalProperties": false
    },
    "OrganizationId": {
      "type": "string",
      "pattern": "^org:[0-9a-f]{16}$",
      "title": "OrganizationId",
      "description": "Content-addressed organization proposal id: \"org:\" + 16 hex characters."
    },
    "CriterionResult": {
      "readOnly": true,
      "title": "CriterionResult",
      "description": "The computed value of one criterion for one organization (null value when undeclared).",
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "metric": {
          "$ref": "#/$defs/EvaluationMetric"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "thresholdMet": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "criterionId",
        "metric",
        "value",
        "thresholdMet"
      ],
      "additionalProperties": false
    },
    "EvaluationMetric": {
      "type": "string",
      "enum": [
        "demand-coverage",
        "unmet-demand-count",
        "evidence-coverage",
        "redundancy-coverage",
        "estimated-latency",
        "estimated-cost",
        "gap-count",
        "critical-single-point-count"
      ],
      "title": "EvaluationMetric",
      "description": "Deterministic organization-evaluation metric: demand-coverage, unmet-demand-count, evidence-coverage, redundancy-coverage, estimated-latency, estimated-cost, gap-count, critical-single-point-count."
    }
  },
  "$id": "urn:epoch:capability-discovery:organization-evaluation:1.0.0"
}
