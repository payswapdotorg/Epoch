{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TaskSignal",
  "$defs": {
    "TaskSignal": {
      "readOnly": true,
      "title": "TaskSignal",
      "description": "One universal task/problem signal (kind + summary + operation pin + subject/evidence/constraint references + neutral hints and kind-specific payloads).",
      "type": "object",
      "properties": {
        "signalId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "kind": {
          "$ref": "#/$defs/TaskSignalKind"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "operationRef": {
          "$ref": "#/$defs/OperationRef"
        },
        "subjectRefs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        },
        "evidenceRefs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoverySha256Hex"
          }
        },
        "constraintRefs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        },
        "representationHints": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "outputHints": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "artifactKind": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "qualityTarget": {
          "$ref": "#/$defs/QualityTarget"
        },
        "latencyBudgetMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costBudget": {
          "$ref": "#/$defs/MoneyAmount"
        },
        "uncertaintyConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requirementSlugs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        },
        "dependsOnOperation": {
          "$ref": "#/$defs/OperationRef"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "signalId",
        "kind",
        "summary",
        "subjectRefs",
        "evidenceRefs",
        "constraintRefs"
      ],
      "additionalProperties": false
    },
    "TaskSignalKind": {
      "type": "string",
      "enum": [
        "operation",
        "decision",
        "verification",
        "artifact",
        "quality",
        "unknown",
        "failure",
        "work",
        "budget",
        "environment",
        "authority",
        "dependency",
        "outcome"
      ],
      "title": "TaskSignalKind",
      "description": "Universal task/problem signal kind: operation, decision, verification, artifact, quality, unknown, failure, work, budget, environment, authority, dependency, outcome."
    },
    "OperationRef": {
      "readOnly": true,
      "title": "OperationRef",
      "description": "Provider-neutral operation reference: dot-namespaced qualified id plus a version constraint (semver core or \"*\").",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "versionConstraint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "versionConstraint"
      ],
      "additionalProperties": false
    },
    "DiscoverySha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "DiscoverySha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "text",
        "numeric",
        "tabular",
        "geometry",
        "image",
        "signal",
        "document",
        "structured",
        "code"
      ],
      "title": "RepresentationKind",
      "description": "Neutral representation/modality kind: text, numeric, tabular, geometry, image, signal, document, structured, code."
    },
    "QualityTarget": {
      "readOnly": true,
      "title": "QualityTarget",
      "description": "Quality/fidelity target: metric, threshold, unit, and direction (min/max).",
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "direction": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "metric",
        "threshold",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    },
    "MoneyAmount": {
      "readOnly": true,
      "title": "MoneyAmount",
      "description": "Cost budget/estimate: ISO 4217 currency code + non-negative decimal amount string.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:task-signal:1.0.0"
}
