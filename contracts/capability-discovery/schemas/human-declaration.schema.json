{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HumanDeclaration",
  "$defs": {
    "HumanDeclaration": {
      "readOnly": true,
      "title": "HumanDeclaration",
      "description": "A human specialist's authorized capability declaration (a role is a task specialization, not a qualification).",
      "type": "object",
      "properties": {
        "declarationId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "$ref": "#/$defs/DiscoveryTenantId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "claimedCapabilities": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimedCapability"
          }
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "constrained",
            "unavailable"
          ]
        },
        "environmentRequirements": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        },
        "latency": {
          "$ref": "#/$defs/LatencyClaim"
        },
        "cost": {
          "$ref": "#/$defs/CostClaim"
        }
      },
      "required": [
        "declarationId",
        "tenantId",
        "displayName",
        "claimedCapabilities",
        "availability",
        "environmentRequirements"
      ],
      "additionalProperties": false
    },
    "DiscoveryTenantId": {
      "type": "string",
      "pattern": "^tenant:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "DiscoveryTenantId",
      "description": "Tenant identifier: \"tenant:\" + lowercase slug (the W009 grammar, mirrored)."
    },
    "ClaimedCapability": {
      "readOnly": true,
      "title": "ClaimedCapability",
      "description": "A candidate's claim to one operation, with neutral input/output representation kinds and quality claim basis.",
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRef"
        },
        "inputKinds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "outputKinds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityTarget"
        },
        "claimBasis": {
          "$ref": "#/$defs/ClaimBasis"
        }
      },
      "required": [
        "operation",
        "inputKinds",
        "outputKinds",
        "claimBasis"
      ],
      "additionalProperties": false
    },
    "OperationRef": {
      "readOnly": true,
      "title": "OperationRef",
      "description": "Provider-neutral operation reference: dot-namespaced qualified id plus a version constraint (semver core or \"*\").",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "versionConstraint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "versionConstraint"
      ],
      "additionalProperties": false
    },
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "text",
        "numeric",
        "tabular",
        "geometry",
        "image",
        "signal",
        "document",
        "structured",
        "code"
      ],
      "title": "RepresentationKind",
      "description": "Neutral representation/modality kind: text, numeric, tabular, geometry, image, signal, document, structured, code."
    },
    "QualityTarget": {
      "readOnly": true,
      "title": "QualityTarget",
      "description": "Quality/fidelity target: metric, threshold, unit, and direction (min/max).",
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "direction": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "metric",
        "threshold",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    },
    "ClaimBasis": {
      "type": "string",
      "enum": [
        "measured",
        "declared"
      ],
      "title": "ClaimBasis",
      "description": "Basis of a capability claim: measured or declared."
    },
    "LatencyClaim": {
      "readOnly": true,
      "title": "LatencyClaim",
      "description": "Declared latency characteristics in whole milliseconds (p95 >= p50).",
      "type": "object",
      "properties": {
        "p50Milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p95Milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "p50Milliseconds",
        "p95Milliseconds"
      ],
      "additionalProperties": false
    },
    "CostClaim": {
      "readOnly": true,
      "title": "CostClaim",
      "description": "Declared cost characteristics: ISO 4217 currency, decimal amount, neutral basis.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "basis": {
          "type": "string",
          "enum": [
            "per-task",
            "per-hour",
            "per-run",
            "none"
          ]
        }
      },
      "required": [
        "currency",
        "amount",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:human-declaration:1.0.0"
}
