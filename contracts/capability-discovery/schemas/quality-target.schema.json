{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/QualityTarget",
  "$defs": {
    "QualityTarget": {
      "readOnly": true,
      "title": "QualityTarget",
      "description": "Quality/fidelity target: metric, threshold, unit, and direction (min/max).",
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "direction": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "metric",
        "threshold",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:quality-target:1.0.0"
}
