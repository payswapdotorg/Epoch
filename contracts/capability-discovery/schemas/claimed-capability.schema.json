{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ClaimedCapability",
  "$defs": {
    "ClaimedCapability": {
      "readOnly": true,
      "title": "ClaimedCapability",
      "description": "A candidate's claim to one operation, with neutral input/output representation kinds and quality claim basis.",
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRef"
        },
        "inputKinds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "outputKinds": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepresentationKind"
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityTarget"
        },
        "claimBasis": {
          "$ref": "#/$defs/ClaimBasis"
        }
      },
      "required": [
        "operation",
        "inputKinds",
        "outputKinds",
        "claimBasis"
      ],
      "additionalProperties": false
    },
    "OperationRef": {
      "readOnly": true,
      "title": "OperationRef",
      "description": "Provider-neutral operation reference: dot-namespaced qualified id plus a version constraint (semver core or \"*\").",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "versionConstraint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "versionConstraint"
      ],
      "additionalProperties": false
    },
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "text",
        "numeric",
        "tabular",
        "geometry",
        "image",
        "signal",
        "document",
        "structured",
        "code"
      ],
      "title": "RepresentationKind",
      "description": "Neutral representation/modality kind: text, numeric, tabular, geometry, image, signal, document, structured, code."
    },
    "QualityTarget": {
      "readOnly": true,
      "title": "QualityTarget",
      "description": "Quality/fidelity target: metric, threshold, unit, and direction (min/max).",
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "direction": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "metric",
        "threshold",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    },
    "ClaimBasis": {
      "type": "string",
      "enum": [
        "measured",
        "declared"
      ],
      "title": "ClaimBasis",
      "description": "Basis of a capability claim: measured or declared."
    }
  },
  "$id": "urn:epoch:capability-discovery:claimed-capability:1.0.0"
}
