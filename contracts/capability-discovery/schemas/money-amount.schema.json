{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MoneyAmount",
  "$defs": {
    "MoneyAmount": {
      "readOnly": true,
      "title": "MoneyAmount",
      "description": "Cost budget/estimate: ISO 4217 currency code + non-negative decimal amount string.",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:capability-discovery:money-amount:1.0.0"
}
