{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LabelDescriptor",
  "$defs": {
    "LabelDescriptor": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "offset2d": {
          "$ref": "#/$defs/Point2d"
        },
        "offset3d": {
          "$ref": "#/$defs/Vec3"
        },
        "style": {
          "$ref": "#/$defs/TextStyle"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "title": "LabelDescriptor",
      "description": "Typed descriptor of a label node: bounded text plus optional 2D/3D offset and neutral styling."
    },
    "Point2d": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Point2d",
      "description": "Finite 2D point (x, y)."
    },
    "Vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "title": "Vec3",
      "description": "Finite 3-component numeric vector (x, y, z)."
    },
    "TextStyle": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/ColorHex"
        },
        "fontSizePx": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "weight": {
          "$ref": "#/$defs/TextWeight"
        }
      },
      "additionalProperties": false,
      "title": "TextStyle",
      "description": "Neutral text styling: optional color, font size, and weight."
    },
    "ColorHex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}([0-9a-f]{2})?$",
      "title": "ColorHex",
      "description": "Presentation color as lowercase hex: #RRGGBB or #RRGGBBAA."
    },
    "TextWeight": {
      "type": "string",
      "enum": [
        "bold",
        "light",
        "medium",
        "regular"
      ],
      "title": "TextWeight",
      "description": "Neutral text weight of a label style."
    }
  }
}
