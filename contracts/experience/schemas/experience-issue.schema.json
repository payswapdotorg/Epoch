{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ExperienceIssue",
  "$defs": {
    "ExperienceIssue": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false,
      "title": "ExperienceIssue",
      "description": "One flattened validation issue: dotted path (\"$\" = root) plus message."
    }
  }
}
