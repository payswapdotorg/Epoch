{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DeviceSpatialCapabilities",
  "$defs": {
    "DeviceSpatialCapabilities": {
      "type": "object",
      "properties": {
        "poseTracking": {
          "$ref": "#/$defs/PoseTrackingKind"
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poseTracking",
        "worldAnchored"
      ],
      "additionalProperties": false,
      "title": "DeviceSpatialCapabilities",
      "description": "Neutral spatial capabilities and budgets of a device descriptor."
    },
    "PoseTrackingKind": {
      "type": "string",
      "enum": [
        "none",
        "3dof",
        "6dof"
      ],
      "title": "PoseTrackingKind",
      "description": "Neutral pose-tracking capability of a device."
    }
  }
}
