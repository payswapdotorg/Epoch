{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/InvoiceId",
  "$defs": {
    "InvoiceId": {
      "type": "string",
      "pattern": "^invoice:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "InvoiceId",
      "description": "Opaque invoice identity: \"invoice:\" followed by a lowercase slug."
    }
  },
  "$id": "urn:epoch:entitlements:invoice-id:1.0.0"
}
