{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PoTotal",
  "$defs": {
    "PoTotal": {
      "readOnly": true,
      "title": "PoTotal",
      "description": "The folded total cost of a purchase order (canonical decimal + ISO 4217 currency).",
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "title": "CurrencyCode",
      "description": "ISO 4217 currency code (three uppercase letters)."
    }
  },
  "$id": "urn:epoch:procurement:po-total:1.0.0"
}
