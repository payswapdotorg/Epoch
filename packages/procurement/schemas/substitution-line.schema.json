{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SubstitutionLine",
  "$defs": {
    "SubstitutionLine": {
      "readOnly": true,
      "title": "SubstitutionLine",
      "description": "One quantity line of a substitution request (original or substitute side): description, quantity+unit.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quantity": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/UnitLabel"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    },
    "UnitLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "title": "UnitLabel",
      "description": "Unit-of-measure label (1-32 characters, provider-neutral)."
    }
  },
  "$id": "urn:epoch:procurement:substitution-line:1.0.0"
}
