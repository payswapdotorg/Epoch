{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProcurementEventPayload",
  "$defs": {
    "ProcurementEventPayload": {
      "readOnly": true,
      "title": "ProcurementEventPayload",
      "description": "Typed event payload of a procurement event: namespaced discriminator plus opaque JSON data (the W010 shape).",
      "type": "object",
      "properties": {
        "discriminator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "data": {
          "readOnly": true,
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "required": [
        "discriminator",
        "data"
      ],
      "additionalProperties": false
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  },
  "$id": "urn:epoch:procurement:procurement-event-payload:1.0.0"
}
