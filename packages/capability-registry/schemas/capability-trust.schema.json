{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityTrust",
  "$defs": {
    "CapabilityTrust": {
      "readOnly": true,
      "title": "CapabilityTrust",
      "description": "Provider-neutral trust surface: origin class, optional opaque curator, optional attestation digest.",
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/CapabilityOrigin"
        },
        "curator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestationDigest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "origin"
      ],
      "additionalProperties": false
    },
    "CapabilityOrigin": {
      "type": "string",
      "enum": [
        "first-party",
        "community",
        "external-software",
        "provisional-document-derived"
      ],
      "title": "CapabilityOrigin",
      "description": "Where a registered capability originates: first-party, community, external software, or provisional document-derived."
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:capability-registry:capability-trust:1.0.0"
}
