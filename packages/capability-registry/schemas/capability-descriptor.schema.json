{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityDescriptor",
  "$defs": {
    "CapabilityDescriptor": {
      "readOnly": true,
      "title": "CapabilityDescriptor",
      "description": "Provider-neutral capability descriptor: display name, inputs, outputs, and stated assumptions (shared ParameterSpec shape).",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "inputs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          }
        },
        "outputs": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          }
        },
        "assumptions": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "displayName",
        "inputs",
        "outputs",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "ParameterSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "enumValues": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "kind",
        "required",
        "description"
      ],
      "additionalProperties": false,
      "title": "ParameterSpec",
      "description": "Named capability parameter with value kind, optionality, and description."
    },
    "ParameterKind": {
      "type": "string",
      "enum": [
        "integer",
        "number",
        "string",
        "boolean",
        "enum",
        "entity-reference",
        "json"
      ],
      "title": "ParameterKind",
      "description": "Value kind of a capability parameter."
    }
  },
  "$id": "urn:epoch:capability-registry:capability-descriptor:1.0.0"
}
