{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RendererAdapterSelection",
  "$defs": {
    "RendererAdapterSelection": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "epoch.renderer-adapter-selection"
        },
        "protocolVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "selectionId": {
          "$ref": "#/$defs/SelectionId"
        },
        "tenantScope": {
          "$ref": "#/$defs/TenantScope"
        },
        "rendererSessionId": {
          "type": "string",
          "pattern": "^rs-[a-z0-9][a-z0-9-]{0,62}$"
        },
        "bindingDigest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "assessmentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "technique": {
          "$ref": "#/$defs/RendererTechnique"
        },
        "reason": {
          "$ref": "#/$defs/SelectionReason"
        },
        "fallbackChain": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RendererTechnique"
          }
        },
        "trace": {
          "readOnly": true,
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectionTraceEntry"
          }
        },
        "effectiveLimits": {
          "type": "object",
          "properties": {
            "graphKinds": {
              "minItems": 1,
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "2d",
                  "3d",
                  "animation",
                  "controls",
                  "narrative",
                  "presence",
                  "timeline-replay"
                ]
              }
            },
            "interaction": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "gamepad",
                  "gaze",
                  "gesture",
                  "keyboard",
                  "pointer",
                  "touch",
                  "voice"
                ]
              }
            },
            "stereoscopic": {
              "type": "boolean"
            },
            "maxGraphNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxGraphEdges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 131072
            },
            "maxTriangles": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000000
            },
            "maxTextureBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1099511627776
            }
          },
          "required": [
            "graphKinds",
            "interaction",
            "stereoscopic",
            "maxGraphNodes",
            "maxGraphEdges"
          ],
          "additionalProperties": false
        },
        "digest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "schema",
        "protocolVersion",
        "selectionId",
        "tenantScope",
        "rendererSessionId",
        "bindingDigest",
        "assessmentDigest",
        "technique",
        "reason",
        "fallbackChain",
        "trace",
        "effectiveLimits",
        "digest"
      ],
      "additionalProperties": false,
      "title": "RendererAdapterSelection",
      "description": "The sealed adapter selection: deterministic technique decision over a W013 binding and a W019 assessment, content-addressed by canonical SHA-256."
    },
    "SelectionId": {
      "type": "string",
      "pattern": "^ras-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "SelectionId",
      "description": "Opaque adapter-selection id (ras-<slug>)."
    },
    "TenantScope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "workspaceId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "projectId": {
          "$ref": "#/$defs/OpaqueScopeId"
        }
      },
      "required": [
        "tenantId"
      ],
      "additionalProperties": false,
      "title": "TenantScope",
      "description": "Tenant scoping of an experience document: owning tenant, optional workspace and project narrowing."
    },
    "OpaqueScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "OpaqueScopeId",
      "description": "Opaque scoping identifier (tenant/workspace/project/participant); bounded, neutral charset."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "RendererTechnique": {
      "type": "string",
      "enum": [
        "immediate-2d",
        "remote-stream",
        "retained-scene-3d",
        "stereoscopic-compositor"
      ],
      "title": "RendererTechnique",
      "description": "Neutral renderer technique: immediate-2d, remote-stream, retained-scene-3d, or stereoscopic-compositor (a technique, never a vendor/engine)."
    },
    "SelectionReason": {
      "type": "string",
      "enum": [
        "flat-kinds",
        "local-technique-unavailable",
        "remote-assist-recommended",
        "spatial-kinds-local",
        "spatial-kinds-local-degraded",
        "stereoscopic-negotiated"
      ],
      "title": "SelectionReason",
      "description": "Typed reason the deterministic adapter selection chose a technique."
    },
    "SelectionTraceEntry": {
      "type": "object",
      "properties": {
        "technique": {
          "$ref": "#/$defs/RendererTechnique"
        },
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/EligibilityReason"
        }
      },
      "required": [
        "technique",
        "eligible",
        "reason"
      ],
      "additionalProperties": false,
      "title": "SelectionTraceEntry",
      "description": "One decision-trace entry: candidate technique, eligibility, and the typed verdict."
    },
    "EligibilityReason": {
      "type": "string",
      "enum": [
        "kind-not-hosted",
        "not-preferred",
        "stereoscopic-unmatched",
        "stereoscopic-unsupported"
      ],
      "title": "EligibilityReason",
      "description": "Typed eligibility verdict of one candidate technique in the selection decision trace."
    }
  },
  "$id": "urn:epoch:renderer-adapters:renderer-adapter-selection:1.0.0"
}
