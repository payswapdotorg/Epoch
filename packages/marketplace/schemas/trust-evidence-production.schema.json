{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TrustEvidenceProduction",
  "$defs": {
    "TrustEvidenceProduction": {
      "readOnly": true,
      "title": "TrustEvidenceProduction",
      "description": "Opaque identifiers of the run, executing actor, and (optional) method that produced the trust evidence (the W006 shape).",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "methodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "runId",
        "actorId"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:marketplace:trust-evidence-production:1.0.0"
}
