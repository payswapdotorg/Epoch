{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TrustExactRevisionRef",
  "$defs": {
    "TrustExactRevisionRef": {
      "readOnly": true,
      "title": "TrustExactRevisionRef",
      "description": "Reference to the exact artifact revision the trust evidence is about: opaque artifact id, revision label, and SHA-256 content digest (the W006 shape).",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "artifactId",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:marketplace:trust-exact-revision-ref:1.0.0"
}
