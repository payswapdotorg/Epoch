{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CameraState",
  "$defs": {
    "CameraState": {
      "oneOf": [
        {
          "$ref": "#/$defs/FollowAgentCamera"
        },
        {
          "$ref": "#/$defs/FreeCamera"
        },
        {
          "$ref": "#/$defs/OrbitCamera"
        }
      ],
      "title": "CameraState",
      "description": "The camera state of a world scene as typed data: orbit, free, or follow-agent (agent plus cursor state)."
    },
    "FollowAgentCamera": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "follow-agent"
        },
        "agentRef": {
          "$ref": "#/$defs/ProjectedAgentRef"
        },
        "followDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cursor": {
          "$ref": "#/$defs/FollowCursorState"
        }
      },
      "required": [
        "mode",
        "agentRef"
      ],
      "additionalProperties": false,
      "title": "FollowAgentCamera"
    },
    "ProjectedAgentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "agentId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedAgentRef",
      "description": "Exact-revision reference to a registered agent (W003 grammar; digest of its registration canonical JSON)."
    },
    "OpaqueScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "OpaqueScopeId",
      "description": "Opaque scoping identifier (tenant/workspace/project/participant); bounded, neutral charset."
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AgentId",
      "description": "Registered agent identifier: \"agent:\" followed by a lowercase slug."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "FollowCursorState": {
      "type": "object",
      "properties": {
        "position2d": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "position3d": {
          "$ref": "#/$defs/Vec3"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "title": "FollowCursorState",
      "description": "The followed agent cursor state: a 2D or 3D position at a virtual time."
    },
    "Vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "title": "Vec3",
      "description": "Finite 3-component numeric vector (x, y, z)."
    },
    "FreeCamera": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "free"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "mode",
        "position"
      ],
      "additionalProperties": false,
      "title": "FreeCamera"
    },
    "Quaternion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "title": "Quaternion",
      "description": "Finite orientation quaternion (x, y, z, w); neutral math, renderer-normalized."
    },
    "OrbitCamera": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "orbit"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        },
        "target": {
          "$ref": "#/$defs/Vec3"
        },
        "fovRadians": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.141592653589793
        }
      },
      "required": [
        "mode",
        "position"
      ],
      "additionalProperties": false,
      "title": "OrbitCamera"
    }
  },
  "$id": "urn:epoch:world-experience:camera-state:1.0.0"
}
