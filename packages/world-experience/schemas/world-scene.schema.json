        },
        "intent": {
          "$ref": "#/$defs/ControlIntent"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "controlId",
        "controlKind",
        "intent"
      ],
      "additionalProperties": false,
      "title": "SceneControl",
      "description": "One candidate/action control: neutral control role, emitted typed intent, optional label and selector options."
    },
    "SceneControlId": {
      "type": "string",
      "pattern": "^ctl-[a-z0-9][a-z0-9-]{0,62}$",
