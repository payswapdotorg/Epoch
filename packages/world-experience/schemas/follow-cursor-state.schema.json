{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FollowCursorState",
  "$defs": {
    "FollowCursorState": {
      "type": "object",
      "properties": {
        "position2d": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "position3d": {
          "$ref": "#/$defs/Vec3"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "title": "FollowCursorState",
      "description": "The followed agent cursor state: a 2D or 3D position at a virtual time."
    },
    "Vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "title": "Vec3",
      "description": "Finite 3-component numeric vector (x, y, z)."
    }
  },
  "$id": "urn:epoch:world-experience:follow-cursor-state:1.0.0"
}
