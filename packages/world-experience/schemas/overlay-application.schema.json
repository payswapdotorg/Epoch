{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OverlayApplication",
  "$defs": {
    "OverlayApplication": {
      "type": "object",
      "properties": {
        "overlayId": {
          "$ref": "#/$defs/WorldOverlayId"
        },
        "orderIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "overlayId",
        "orderIndex"
      ],
      "additionalProperties": false,
      "title": "OverlayApplication",
      "description": "One applied overlay: id plus deterministic application order index."
    },
    "WorldOverlayId": {
      "type": "string",
      "pattern": "^ovl-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "WorldOverlayId",
      "description": "Visual-overlay identifier: \"ovl-\" followed by a lowercase slug."
    }
  },
  "$id": "urn:epoch:world-experience:overlay-application:1.0.0"
}
