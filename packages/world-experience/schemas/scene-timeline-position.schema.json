{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SceneTimelinePosition",
  "$defs": {
    "SceneTimelinePosition": {
      "type": "object",
      "properties": {
        "atMs": {
          "$ref": "#/$defs/WorldVirtualTimeMs"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paused": {
          "type": "boolean"
        },
        "replayWindow": {
          "$ref": "#/$defs/ReplayWindow"
        }
      },
      "required": [
        "atMs",
        "frameIndex",
        "paused"
      ],
      "additionalProperties": false,
      "title": "SceneTimelinePosition",
      "description": "The scene timeline/replay position: virtual time, frame index, paused flag, optional replay window."
    },
    "WorldVirtualTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "title": "WorldVirtualTimeMs",
      "description": "Virtual time in non-negative integer milliseconds (caller-supplied; never a wall clock)."
    },
    "ReplayWindow": {
      "type": "object",
      "properties": {
        "fromSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toSequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fromSequence",
        "toSequence"
      ],
      "additionalProperties": false,
      "title": "ReplayWindow",
      "description": "Bounded world-model event-sequence window for timeline/replay projections (from inclusive, to exclusive)."
    }
  },
  "$id": "urn:epoch:world-experience:scene-timeline-position:1.0.0"
}
