{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AnimationInstruction",
  "$defs": {
    "AnimationInstruction": {
      "type": "object",
      "properties": {
        "instructionId": {
          "$ref": "#/$defs/AnimationInstructionId"
        },
        "targetEntityId": {
          "$ref": "#/$defs/WorldEntityId"
        },
        "propertyPath": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        },
        "keyframes": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Keyframe"
          }
        },
        "easing": {
          "$ref": "#/$defs/EasingKind"
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "loop": {
          "type": "boolean"
        },
        "startAtMs": {
          "$ref": "#/$defs/WorldVirtualTimeMs"
        }
      },
      "required": [
        "instructionId",
        "targetEntityId",
        "propertyPath",
        "keyframes",
        "easing",
        "durationMs",
        "loop"
      ],
      "additionalProperties": false,
      "title": "AnimationInstruction",
      "description": "One animation instruction: target entity, presentation property path, strictly ordered keyframes, easing, duration, loop."
    },
    "AnimationInstructionId": {
      "type": "string",
      "pattern": "^ani-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AnimationInstructionId",
      "description": "Animation-instruction identifier: \"ani-\" followed by a lowercase slug."
    },
    "WorldEntityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "WorldEntityId",
      "description": "Opaque world-entity identity (mirrored shared grammar; canonical home @epoch/world-model): 1..256 chars, caller-assigned."
    },
    "Keyframe": {
      "type": "object",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "easing": {
          "$ref": "#/$defs/EasingKind"
        }
      },
      "required": [
        "atMs",
        "value"
      ],
      "additionalProperties": false,
      "title": "Keyframe",
      "description": "One animation keyframe: millisecond offset, JSON value, optional easing."
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "EasingKind": {
      "type": "string",
      "enum": [
        "ease-in",
        "ease-in-out",
        "ease-out",
        "linear",
        "step"
      ],
      "title": "EasingKind",
      "description": "Neutral interpolation of one animation keyframe segment."
    },
    "WorldVirtualTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "title": "WorldVirtualTimeMs",
      "description": "Virtual time in non-negative integer milliseconds (caller-supplied; never a wall clock)."
    }
  },
  "$id": "urn:epoch:world-experience:animation-instruction:1.0.0"
}
