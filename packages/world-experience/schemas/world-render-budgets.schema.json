{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/WorldRenderBudgets",
  "$defs": {
    "WorldRenderBudgets": {
      "type": "object",
      "properties": {
        "maxGraphNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxGraphEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1099511627776
        }
      },
      "required": [
        "maxGraphNodes",
        "maxGraphEdges"
      ],
      "additionalProperties": false,
      "title": "WorldRenderBudgets",
      "description": "Renderer budgets a world-scene compilation enforces (mirrored shared record; canonical home @epoch/renderer-runtime)."
    }
  },
  "$id": "urn:epoch:world-experience:world-render-budgets:1.0.0"
}
