{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SceneControl",
  "$defs": {
    "SceneControl": {
      "type": "object",
      "properties": {
        "controlId": {
          "$ref": "#/$defs/SceneControlId"
        },
        "controlKind": {
          "$ref": "#/$defs/ControlKind"
        },
        "intent": {
          "$ref": "#/$defs/ControlIntent"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "controlId",
        "controlKind",
        "intent"
      ],
      "additionalProperties": false,
      "title": "SceneControl",
      "description": "One candidate/action control: neutral control role, emitted typed intent, optional label and selector options."
    },
    "SceneControlId": {
      "type": "string",
      "pattern": "^ctl-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "SceneControlId",
      "description": "Scene candidate/action-control identifier: \"ctl-\" followed by a lowercase slug."
    },
    "ControlKind": {
      "type": "string",
      "enum": [
        "axis",
        "button",
        "selector",
        "toggle"
      ],
      "title": "ControlKind",
      "description": "Neutral interaction-control role of a controls-graph node."
    },
    "ControlIntent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "ControlIntent",
      "description": "Typed UI intent a control emits: qualified id plus semver core (shape-compatible with the action-protocol ActionTypeReference)."
    }
  },
  "$id": "urn:epoch:world-experience:scene-control:1.0.0"
}
