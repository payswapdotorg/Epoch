{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FidelityReduction",
  "$defs": {
    "FidelityReduction": {
      "type": "object",
      "properties": {
        "aspect": {
          "type": "string",
          "enum": [
            "animation-instructions",
            "applied-overlays",
            "narrative-blocks",
            "presence-participants",
            "spatial-presentation",
            "timeline-markers"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "fidelity-max-animation-instructions",
            "fidelity-max-applied-overlays",
            "fidelity-max-timeline-markers",
            "fidelity-narrative-detail",
            "fidelity-presence-detail",
            "fidelity-spatial-disabled"
          ]
        },
        "encountered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "aspect",
        "reason",
        "encountered",
        "retained"
      ],
      "additionalProperties": false,
      "title": "FidelityReduction",
      "description": "One explicit fidelity reduction: aspect, typed reason, encountered vs retained counts (never silent degradation)."
    }
  },
  "$id": "urn:epoch:world-experience:fidelity-reduction:1.0.0"
}
