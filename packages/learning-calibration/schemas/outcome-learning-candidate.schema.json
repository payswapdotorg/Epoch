    "ValidationStateEvidence": {
      "readOnly": true,
      "title": "ValidationStateEvidence",
      "description": "One opaque typed validation-state evidence: the W039 validation state of the observation group backing the actual side (insufficient/corroborated/conflicting/resolved) plus the exact-revision assessment reference that derived it.",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "insufficient",
            "corroborated",
            "conflicting",
            "resolved"
          ]
        },
        "assessmentRef": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "recordId": {
              "type": "string",
              "pattern": "^validation:[a-z0-9][a-z0-9-]{0,62}$"
            },
            "contentDigest": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": [
            "recordId",
            "contentDigest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "state",
        "assessmentRef"
      ],
      "additionalProperties": false
    },
    "VarianceEvidence": {
      "readOnly": true,
      "title": "VarianceEvidence",
      "description": "One opaque typed variance evidence: the W039 variance class of the compared deviation, the exact-revision variance-record reference, and the optional evidence-grounded root-cause attribution.",
      "type": "object",
      "properties": {
        "varianceClass": {
          "type": "string",
          "enum": [
            "quantity",
            "price-rate",
            "productivity",
            "schedule",
            "waste",
            "rework",
            "change",
            "external-condition"
          ]
        },
        "varianceRecordRef": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "recordId": {
              "type": "string",
              "pattern": "^variance:[a-z0-9][a-z0-9-]{0,62}$"
            },
            "contentDigest": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": [
            "recordId",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "attribution": {
          "anyOf": [
            {
              "readOnly": true,
              "type": "object",
              "properties": {
                "cause": {
                  "$ref": "#/$defs/LearningCauseRef"
                },
                "evidence": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Sha256Hex"
                  }
                }
              },
              "required": [
                "cause",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "varianceClass",
        "varianceRecordRef",
        "attribution"
      ],
      "additionalProperties": false
    },
    "LearningCauseRef": {
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "causeKind": {
              "type": "string",
              "const": "change-record"
            },
            "recordId": {
              "type": "string",
              "pattern": "^change:[a-z0-9][a-z0-9-]{0,62}$"
            },
            "contentDigest": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": [
            "causeKind",
            "recordId",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "causeKind": {
              "type": "string",
              "const": "issue-record"
            },
            "recordId": {
              "type": "string",
              "pattern": "^(change|delay|rework|defect|blocker):[a-z0-9][a-z0-9-]{0,62}$"
            },
            "contentDigest": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": [
            "causeKind",
            "recordId",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "causeKind": {
              "type": "string",
              "const": "external-condition"
            },
            "recordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "contentDigest": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": [
            "causeKind",
            "recordId",
            "contentDigest"
          ],
          "additionalProperties": false
        }
      ],
      "title": "LearningCauseRef",
      "description": "One opaque typed root-cause attribution (the W039 cause grammar): cause kind, opaque record id, exact content digest, and the mandatory sorted evidence digests."
    },
    "PackReference": {
      "readOnly": true,
      "title": "PackReference",
      "description": "One typed exact-revision reference to a W036 SolutionPackProfile: qualified pack id, semantic version, and the content digest of that profile revision.",
      "type": "object",
      "properties": {
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
        },
        "packVersion": {
          "$ref": "#/$defs/SemverCore"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "packId",
        "packVersion",
        "contentDigest"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:learning-calibration:outcome-learning-candidate:1.0.0"
}
