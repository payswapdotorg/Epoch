{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DatasetLineageRef",
  "$defs": {
    "DatasetLineageRef": {
      "readOnly": true,
      "title": "DatasetLineageRef",
      "description": "One exact-revision dataset reference of a model revision lineage: dataset id plus content digest.",
      "type": "object",
      "properties": {
        "datasetId": {
          "$ref": "#/$defs/LearningDatasetId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "datasetId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "LearningDatasetId": {
      "type": "string",
      "pattern": "^dataset:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "LearningDatasetId",
      "description": "Opaque learning-dataset record identity: \"dataset:\" followed by a lowercase slug."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:learning-calibration:dataset-lineage-ref:1.0.0"
}
