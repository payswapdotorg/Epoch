{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HitRateSummary",
  "$defs": {
    "HitRateSummary": {
      "readOnly": true,
      "title": "HitRateSummary",
      "description": "One hit-rate summary: the declared tolerance band, the within/outside counts, and the exact truncating within fraction.",
      "type": "object",
      "properties": {
        "tolerance": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "withinCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "outsideCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "hitRate": {
          "$ref": "#/$defs/NonNegativeDecimal"
        }
      },
      "required": [
        "tolerance",
        "withinCount",
        "outsideCount",
        "hitRate"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    }
  },
  "$id": "urn:epoch:learning-calibration:hit-rate-summary:1.0.0"
}
