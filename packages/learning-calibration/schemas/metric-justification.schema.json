{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MetricJustification",
  "$defs": {
    "MetricJustification": {
      "readOnly": true,
      "title": "MetricJustification",
      "description": "One machine-referenceable justification entry of a metric set: the kind (dataset / model / fold-definition / observation) plus the record id or digest it rests on.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dataset",
            "model",
            "fold-definition",
            "observation"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:learning-calibration:metric-justification:1.0.0"
}
