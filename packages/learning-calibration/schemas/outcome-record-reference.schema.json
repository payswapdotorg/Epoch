{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OutcomeRecordReference",
  "$defs": {
    "OutcomeRecordReference": {
      "readOnly": true,
      "title": "OutcomeRecordReference",
      "description": "One exact-revision reference to a W036 Outcome-distinction record: record id plus content digest.",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^outcome:[a-z0-9][a-z0-9-]{0,62}$"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "recordId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:learning-calibration:outcome-record-reference:1.0.0"
}
