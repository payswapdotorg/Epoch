{
  "name": "@epoch/verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Epoch Verification kernel — the typed Requirement -> Claim -> Method -> Run -> Evidence -> Result -> Approval chain with reference chain validation, distinct verification/validation stages, and approval-as-authority (W006).",
