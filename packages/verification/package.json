    "test": "vitest run"
  },
  "dependencies": {
    "@epoch/agent-protocol": "workspace:*",
    "@epoch/evidence": "workspace:*",
    "@epoch/provenance": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@epoch/eslint-config": "workspace:*",
    "@epoch/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
