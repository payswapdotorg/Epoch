{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:evidence:confidence-distribution",
  "$defs": {
    "urn:epoch:evidence:confidence-distribution": {
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "point"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "interval"
            },
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bias": {
              "$ref": "#/$defs/urn:epoch:evidence:interval-bias"
            }
          },
          "required": [
            "kind",
            "lower",
            "upper"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set"
            },
            "values": {
              "readOnly": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "weights": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        }
      ],
      "title": "ConfidenceDistribution",
      "description": "Bounded [0,1] uncertainty distribution: point, interval, or weighted set (W002-aligned)."
    },
    "urn:epoch:evidence:interval-bias": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "high"
      ],
      "title": "IntervalBias",
      "description": "Directional bias admitted for interval confidence estimates: none, low, high."
    }
  },
  "$id": "urn:epoch:evidence:confidence-distribution:1.0.0"
}
