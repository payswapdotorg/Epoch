{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:evidence:evidence-payload",
  "$defs": {
    "urn:epoch:evidence:evidence-payload": {
      "readOnly": true,
      "title": "EvidencePayload",
      "description": "JSON-representable payload plus media type and optional out-of-band locator.",
      "type": "object",
      "properties": {
        "mediaType": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "mediaType",
        "data"
      ],
      "additionalProperties": false
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  },
  "$id": "urn:epoch:evidence:evidence-payload:1.0.0"
}
