{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PlannedCost",
  "$defs": {
    "PlannedCost": {
      "readOnly": true,
      "title": "PlannedCost",
      "description": "The planned cost total of one rolling cost forecast: canonical decimal amount plus ISO 4217 currency code.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cost"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "kind",
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:actualization:planned-cost:1.0.0"
}
