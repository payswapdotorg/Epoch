{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PlannedMeasure",
  "$defs": {
    "PlannedMeasure": {
      "oneOf": [
        {
          "$ref": "#/$defs/PlannedQuantity"
        },
        {
          "$ref": "#/$defs/PlannedCost"
        }
      ],
      "title": "PlannedMeasure",
      "description": "One rolling-forecast plan measure: a planned quantity total or a planned cost total (the remaining-plan input)."
    },
    "PlannedQuantity": {
      "readOnly": true,
      "title": "PlannedQuantity",
      "description": "The planned quantity total of one rolling completion forecast: canonical decimal value plus unit-of-measure label.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "quantity"
        },
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "PlannedCost": {
      "readOnly": true,
      "title": "PlannedCost",
      "description": "The planned cost total of one rolling cost forecast: canonical decimal amount plus ISO 4217 currency code.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cost"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "kind",
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:actualization:planned-measure:1.0.0"
}
