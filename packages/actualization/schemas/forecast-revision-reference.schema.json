{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ForecastRevisionReference",
  "$defs": {
    "ForecastRevisionReference": {
      "readOnly": true,
      "title": "ForecastRevisionReference",
      "description": "One W036 Forecast-distinction record reference: the forecast record id plus its exact content digest (the rolling-forecast refinement chain link).",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^forecast:[a-z0-9][a-z0-9-]{0,62}$"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "recordId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:actualization:forecast-revision-reference:1.0.0"
}
