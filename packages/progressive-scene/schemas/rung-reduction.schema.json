{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RungReduction",
  "$defs": {
    "RungReduction": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "downgrade-expensive-primitives",
            "drop-animation-clips",
            "prune-control-nodes",
            "prune-presence-cursors",
            "prune-presence-seats",
            "prune-shape-nodes",
            "prune-spatial-nodes",
            "prune-timeline-markers",
            "prune-timeline-tracks",
            "prune-to-minimal-core",
            "substitute-mesh-proxies"
          ]
        },
        "prunedNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrimitiveSubstitution"
          }
        },
        "droppedEdgeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usageBefore": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "estimatedTriangles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "assetBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "nodes",
            "edges",
            "estimatedTriangles",
            "assetBytes"
          ],
          "additionalProperties": false
        },
        "usageAfter": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "estimatedTriangles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "assetBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "nodes",
            "edges",
            "estimatedTriangles",
            "assetBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stage",
        "prunedNodeIds",
        "substitutions",
        "droppedEdgeCount",
        "usageBefore",
        "usageAfter"
      ],
      "additionalProperties": false,
      "title": "RungReduction",
      "description": "The explicit reduction manifest of one progressive-scene rung: stage, pruned nodes, substitutions, dropped edges, and usage before/after (never silent)."
    },
    "PrimitiveSubstitution": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "fromPrimitive": {
          "type": "string",
          "enum": [
            "box",
            "cone",
            "cylinder",
            "mesh",
            "plane",
            "sphere"
          ]
        },
        "toPrimitive": {
          "type": "string",
          "enum": [
            "box",
            "cone",
            "cylinder",
            "mesh",
            "plane",
            "sphere"
          ]
        }
      },
      "required": [
        "nodeId",
        "fromPrimitive",
        "toPrimitive"
      ],
      "additionalProperties": false,
      "title": "PrimitiveSubstitution",
      "description": "One explicit primitive substitution: node id, source primitive, proxy primitive."
    }
  },
  "$id": "urn:epoch:progressive-scene:rung-reduction:1.0.0"
}
