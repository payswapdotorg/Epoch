{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SceneUsage",
  "$defs": {
    "SceneUsage": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedTriangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assetBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodes",
        "edges",
        "estimatedTriangles",
        "assetBytes"
      ],
      "additionalProperties": false,
      "title": "SceneUsage",
      "description": "The deterministic resource usage of one scene graph: exact node/edge counts, per-primitive triangle estimate, and declared asset bytes."
    }
  },
  "$id": "urn:epoch:progressive-scene:scene-usage:1.0.0"
}
