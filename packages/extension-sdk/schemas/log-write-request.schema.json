{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LogWriteRequest",
  "$defs": {
    "LogWriteRequest": {
      "readOnly": true,
      "title": "LogWriteRequest",
      "description": "log.write request: level plus message.",
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/HostLogLevel"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "level",
        "message"
      ],
      "additionalProperties": false
    },
    "HostLogLevel": {
      "type": "string",
      "enum": [
        "debug",
        "error",
        "info",
        "warn"
      ],
      "title": "HostLogLevel",
      "description": "Log level of a log.write host call: debug, error, info, or warn."
    }
  },
  "$id": "urn:epoch:extension-sdk:log-write-request:1.0.0"
}
