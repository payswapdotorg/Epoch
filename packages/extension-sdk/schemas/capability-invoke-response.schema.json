{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityInvokeResponse",
  "$defs": {
    "CapabilityInvokeResponse": {
      "readOnly": true,
      "title": "CapabilityInvokeResponse",
      "description": "capability.invoke response: named outputs.",
      "type": "object",
      "properties": {
        "outputs": {
          "readOnly": true,
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "required": [
        "outputs"
      ],
      "additionalProperties": false
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  },
  "$id": "urn:epoch:extension-sdk:capability-invoke-response:1.0.0"
}
