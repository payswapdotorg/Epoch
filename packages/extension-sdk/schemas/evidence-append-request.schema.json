{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidenceAppendRequest",
  "$defs": {
    "EvidenceAppendRequest": {
      "readOnly": true,
      "title": "EvidenceAppendRequest",
      "description": "evidence.append request: statement plus optional subject digest.",
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "subjectDigest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "statement"
      ],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:extension-sdk:evidence-append-request:1.0.0"
}
