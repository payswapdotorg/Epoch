{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SessionScope",
  "$defs": {
    "SessionScope": {
      "readOnly": true,
      "title": "SessionScope",
      "description": "Optional tenant-hierarchy narrowing of a session: workspace and (with it) project ids.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^workspace:[a-z0-9][a-z0-9-]{0,62}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^project:[a-z0-9][a-z0-9-]{0,62}$"
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:collaboration:session-scope:1.0.0"
}
