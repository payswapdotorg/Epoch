{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidencePath",
  "$defs": {
    "EvidencePath": {
      "readOnly": true,
      "title": "EvidencePath",
      "description": "Exact evidence path: the artifact revision backing a decision — opaque artifact id, revision label, and SHA-256 content digest (the @epoch/evidence exact-revision form).",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "artifactId",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:authorization:evidence-path:1.0.0"
}
