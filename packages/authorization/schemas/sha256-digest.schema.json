{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Sha256Digest",
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:authorization:sha256-digest:1.0.0"
}
