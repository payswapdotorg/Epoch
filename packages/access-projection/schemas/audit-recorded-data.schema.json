{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "auditId": {
      "type": "string",
      "pattern": "^audit:[0-9a-f]{16}$"
    },
    "evaluationKey": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "auditDigest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "released",
        "denied"
      ]
    }
  },
  "required": [
    "auditId",
    "evaluationKey",
    "auditDigest",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:access-projection:audit-recorded-data:1.0.0"
}
