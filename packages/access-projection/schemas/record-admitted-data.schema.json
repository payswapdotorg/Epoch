{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "objectClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "objectDigest": {
      "$ref": "#/$defs/Sha256Hex"
    }
  },
  "required": [
    "objectClass",
    "objectId",
    "objectDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:access-projection:record-admitted-data:1.0.0"
}
