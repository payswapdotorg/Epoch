{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "objectClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "objectDigest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "principalId": {
      "type": "string",
      "pattern": "^principal:[a-z0-9][a-z0-9-]{0,62}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "view",
        "export",
        "share"
      ]
    },
    "policyDigest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "projectionDigest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "auditDigest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "releasedFieldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "redactedFieldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "objectClass",
    "objectId",
    "objectDigest",
    "principalId",
    "action",
    "policyDigest",
    "projectionDigest",
    "auditDigest",
    "releasedFieldCount",
    "redactedFieldCount"
  ],
  "additionalProperties": false,
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:access-projection:projection-released-data:1.0.0"
}
