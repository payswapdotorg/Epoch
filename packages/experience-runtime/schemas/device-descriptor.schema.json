{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DeviceDescriptor",
  "$defs": {
    "DeviceDescriptor": {
      "type": "object",
      "properties": {
        "descriptorVersion": {
          "type": "number",
          "const": 1
        },
        "deviceClass": {
          "$ref": "#/$defs/DeviceClass"
        },
        "interaction": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "display": {
          "$ref": "#/$defs/DeviceDisplayCapabilities"
        },
        "spatial": {
          "$ref": "#/$defs/DeviceSpatialCapabilities"
        },
        "latencyBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "descriptorVersion",
        "deviceClass",
        "interaction",
        "display",
        "spatial"
      ],
      "additionalProperties": false,
      "title": "DeviceDescriptor",
      "description": "Abstract, provider-neutral device descriptor: capabilities and budgets as typed data; filled/adapted by renderer/device adaptation (W019)."
    },
    "DeviceClass": {
      "type": "string",
      "enum": [
        "desktop",
        "laptop",
        "tablet",
        "phone",
        "headset",
        "wall-display"
      ],
      "title": "DeviceClass",
      "description": "Neutral device class of a device descriptor (never a vendor product)."
    },
    "InteractionModality": {
      "type": "string",
      "enum": [
        "gamepad",
        "gaze",
        "gesture",
        "keyboard",
        "pointer",
        "touch",
        "voice"
      ],
      "title": "InteractionModality",
      "description": "Neutral interaction modality of a device."
    },
    "DeviceDisplayCapabilities": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stereoscopic"
      ],
      "additionalProperties": false,
      "title": "DeviceDisplayCapabilities",
      "description": "Neutral display capabilities and budgets of a device descriptor."
    },
    "DeviceSpatialCapabilities": {
      "type": "object",
      "properties": {
        "poseTracking": {
          "$ref": "#/$defs/PoseTrackingKind"
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poseTracking",
        "worldAnchored"
      ],
      "additionalProperties": false,
      "title": "DeviceSpatialCapabilities",
      "description": "Neutral spatial capabilities and budgets of a device descriptor."
    },
    "PoseTrackingKind": {
      "type": "string",
      "enum": [
        "none",
        "3dof",
        "6dof"
      ],
      "title": "PoseTrackingKind",
      "description": "Neutral pose-tracking capability of a device."
    }
  }
}
