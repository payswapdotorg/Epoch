{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityGap",
  "$defs": {
    "CapabilityGap": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CapabilityGapKind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "encountered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modality": {
          "type": "string",
          "enum": [
            "gamepad",
            "gaze",
            "gesture",
            "keyboard",
            "pointer",
            "touch",
            "voice"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "title": "CapabilityGap",
      "description": "One typed capability gap: kind, device path, encountered vs required values, and the missing modality when applicable."
    },
    "CapabilityGapKind": {
      "type": "string",
      "enum": [
        "modality-gap",
        "pixel-budget-shortfall",
        "pose-tracking-insufficient",
        "stereoscopic-mismatch",
        "texture-budget-shortfall",
        "triangle-budget-shortfall"
      ],
      "title": "CapabilityGapKind",
      "description": "Typed kind of one presentation-requirement gap: which capability axis fell short."
    }
  },
  "$id": "urn:epoch:device-capabilities:capability-gap:1.0.0"
}
