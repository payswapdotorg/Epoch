{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PresentationRequirement",
  "$defs": {
    "PresentationRequirement": {
      "type": "object",
      "properties": {
        "requirementVersion": {
          "type": "number",
          "const": 1
        },
        "requirementId": {
          "$ref": "#/$defs/PresentationRequirementId"
        },
        "spatial": {
          "type": "boolean"
        },
        "stereoscopic": {
          "type": "boolean"
        },
        "minPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requiredModalities": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "minPoseTracking": {
          "type": "string",
          "enum": [
            "none",
            "3dof",
            "6dof"
          ]
        }
      },
      "required": [
        "requirementVersion",
        "requirementId",
        "spatial",
        "stereoscopic",
        "requiredModalities",
        "minPoseTracking"
      ],
      "additionalProperties": false,
      "title": "PresentationRequirement",
      "description": "One declared presentation requirement: spatial flag, stereoscopic flag, minimum budgets, required modalities, and minimum pose tracking (typed data)."
    },
    "PresentationRequirementId": {
      "type": "string",
      "pattern": "^prr-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "PresentationRequirementId",
      "description": "Opaque presentation-requirement id (prr-<slug>)."
    },
    "InteractionModality": {
      "type": "string",
      "enum": [
        "gamepad",
        "gaze",
        "gesture",
        "keyboard",
        "pointer",
        "touch",
        "voice"
      ],
      "title": "InteractionModality",
      "description": "Neutral interaction modality of a device."
    }
  },
  "$id": "urn:epoch:device-capabilities:presentation-requirement:1.0.0"
}
