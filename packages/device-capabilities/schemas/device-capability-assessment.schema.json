{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DeviceCapabilityAssessment",
  "$defs": {
    "DeviceCapabilityAssessment": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "epoch.device-capability-assessment"
        },
        "protocolVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "assessmentId": {
          "$ref": "#/$defs/AssessmentId"
        },
        "device": {
          "$ref": "#/$defs/DeviceDescriptor"
        },
        "tier": {
          "$ref": "#/$defs/DeviceAdaptationTier"
        },
        "derivation": {
          "$ref": "#/$defs/TierDerivation"
        },
        "display": {
          "$ref": "#/$defs/DisplayAxis"
        },
        "spatial": {
          "$ref": "#/$defs/SpatialAxis"
        },
        "interaction": {
          "$ref": "#/$defs/ModalityCoverage"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "schema",
        "protocolVersion",
        "assessmentId",
        "device",
        "tier",
        "derivation",
        "display",
        "spatial",
        "interaction",
        "digest"
      ],
      "additionalProperties": false,
      "title": "DeviceCapabilityAssessment",
      "description": "The sealed device capability assessment: deterministic tier derivation over a W011 device descriptor, content-addressed by canonical SHA-256."
    },
    "AssessmentId": {
      "type": "string",
      "pattern": "^dca-[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AssessmentId",
      "description": "Opaque device-capability assessment id (dca-<slug>)."
    },
    "DeviceDescriptor": {
      "type": "object",
      "properties": {
        "descriptorVersion": {
          "type": "number",
          "const": 1
        },
        "deviceClass": {
          "$ref": "#/$defs/DeviceClass"
        },
        "interaction": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionModality"
          }
        },
        "display": {
          "$ref": "#/$defs/DeviceDisplayCapabilities"
        },
        "spatial": {
          "$ref": "#/$defs/DeviceSpatialCapabilities"
        },
        "latencyBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "descriptorVersion",
        "deviceClass",
        "interaction",
        "display",
        "spatial"
      ],
      "additionalProperties": false,
      "title": "DeviceDescriptor",
      "description": "Abstract, provider-neutral device descriptor: capabilities and budgets as typed data; filled/adapted by renderer/device adaptation (W019)."
    },
    "DeviceClass": {
      "type": "string",
      "enum": [
        "desktop",
        "laptop",
        "tablet",
        "phone",
        "headset",
        "wall-display"
      ],
      "title": "DeviceClass",
      "description": "Neutral device class of a device descriptor (never a vendor product)."
    },
    "InteractionModality": {
      "type": "string",
      "enum": [
        "gamepad",
        "gaze",
        "gesture",
        "keyboard",
        "pointer",
        "touch",
        "voice"
      ],
      "title": "InteractionModality",
      "description": "Neutral interaction modality of a device."
    },
    "DeviceDisplayCapabilities": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stereoscopic"
      ],
      "additionalProperties": false,
      "title": "DeviceDisplayCapabilities",
      "description": "Neutral display capabilities and budgets of a device descriptor."
    },
    "DeviceSpatialCapabilities": {
      "type": "object",
      "properties": {
        "poseTracking": {
          "$ref": "#/$defs/PoseTrackingKind"
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poseTracking",
        "worldAnchored"
      ],
      "additionalProperties": false,
      "title": "DeviceSpatialCapabilities",
      "description": "Neutral spatial capabilities and budgets of a device descriptor."
    },
    "PoseTrackingKind": {
      "type": "string",
      "enum": [
        "none",
        "3dof",
        "6dof"
      ],
      "title": "PoseTrackingKind",
      "description": "Neutral pose-tracking capability of a device."
    },
    "DeviceAdaptationTier": {
      "type": "string",
      "enum": [
        "field",
        "full",
        "normal",
        "reduced"
      ],
      "title": "DeviceAdaptationTier",
      "description": "Typed device adaptation tier derived from the W011 device descriptor: full, normal, field, or reduced (same semantics, different fidelity)."
    },
    "TierDerivation": {
      "type": "object",
      "properties": {
        "budgetFloorTier": {
          "$ref": "#/$defs/DeviceAdaptationTier"
        },
        "classCeilingTier": {
          "$ref": "#/$defs/DeviceAdaptationTier"
        },
        "derivedTier": {
          "$ref": "#/$defs/DeviceAdaptationTier"
        },
        "guidedFidelity": {
          "$ref": "#/$defs/GuidedFidelityLevel"
        },
        "remoteAssistRecommended": {
          "type": "boolean"
        }
      },
      "required": [
        "budgetFloorTier",
        "classCeilingTier",
        "derivedTier",
        "guidedFidelity",
        "remoteAssistRecommended"
      ],
      "additionalProperties": false,
      "title": "TierDerivation",
      "description": "The deterministic tier-derivation trace: budget-floor tier, class ceiling, derived tier, guided fidelity level, and the remote-assist recommendation."
    },
    "GuidedFidelityLevel": {
      "type": "string",
      "enum": [
        "desktop",
        "low",
        "mobile",
        "remote",
        "web"
      ],
      "title": "GuidedFidelityLevel",
      "description": "Fidelity-level guidance vocabulary (structural mirror of the W016 WorldFidelityLevel; the host remains the chooser)."
    },
    "DisplayAxis": {
      "type": "object",
      "properties": {
        "stereoscopic": {
          "type": "boolean"
        },
        "maxPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "refreshHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorDepthBits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stereoscopic"
      ],
      "additionalProperties": false,
      "title": "DisplayAxis",
      "description": "The display-axis snapshot of a device capability assessment."
    },
    "SpatialAxis": {
      "type": "object",
      "properties": {
        "poseTracking": {
          "type": "string",
          "enum": [
            "none",
            "3dof",
            "6dof"
          ]
        },
        "worldAnchored": {
          "type": "boolean"
        },
        "maxTriangles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTextureBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "poseTracking",
        "worldAnchored"
      ],
      "additionalProperties": false,
      "title": "SpatialAxis",
      "description": "The spatial-axis snapshot of a device capability assessment."
    },
    "ModalityCoverage": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gamepad",
          "gaze",
          "gesture",
          "keyboard",
          "pointer",
          "touch",
          "voice"
        ]
      },
      "title": "ModalityCoverage",
      "description": "The sorted interaction-modality coverage snapshot of an assessment."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:device-capabilities:device-capability-assessment:1.0.0"
}
