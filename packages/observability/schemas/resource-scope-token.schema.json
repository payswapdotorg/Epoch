{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ResourceScopeToken",
  "$defs": {
    "ResourceScopeToken": {
      "readOnly": true,
      "title": "ResourceScopeToken",
      "description": "One (resource, access) scope token of a sandbox grant (validated against the W008 legal table by the isolation check).",
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "access": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "resource",
        "access"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:observability:resource-scope-token:1.0.0"
}
