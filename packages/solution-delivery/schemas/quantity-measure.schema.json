{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/QuantityMeasure",
  "$defs": {
    "QuantityMeasure": {
      "readOnly": true,
      "title": "QuantityMeasure",
      "description": "A quantity measure: canonical decimal value plus a unit-of-measure label.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "quantity"
        },
        "value": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/UnitLabel"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    },
    "UnitLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "title": "UnitLabel",
      "description": "Unit-of-measure label (1-32 characters, provider-neutral)."
    }
  },
  "$id": "urn:epoch:solution-delivery:quantity-measure:1.0.0"
}
