            },
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "recordId": {
              "$ref": "#/$defs/DistinctionRecordId"
            },
            "tenantId": {
              "$ref": "#/$defs/TenantId"
            },
            "subject": {
              "$ref": "#/$defs/DistinctionSubject"
            },
            "recordedAt": {
              "$ref": "#/$defs/Timestamp"
            },
            "recordedBy": {
