              "$ref": "#/$defs/PrincipalId"
            },
            "uncertainty": {
              "$ref": "#/$defs/UncertaintyState"
            },
            "kind": {
              "type": "string",
              "const": "forecast"
            },
            "measure": {
              "$ref": "#/$defs/Measure"
            },
            "payload": {
              "$ref": "#/$defs/ForecastPayload"
            }
          },
          "required": [
            "schema",
