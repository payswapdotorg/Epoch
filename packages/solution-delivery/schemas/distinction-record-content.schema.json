{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DistinctionRecordContent",
  "$defs": {
    "DistinctionRecordContent": {
      "readOnly": true,
      "title": "DistinctionRecordContent",
      "description": "The immutable content of one semantic-distinction record: kind discriminator, kind-prefixed record id, tenant scope, subject, measure (where applicable), kind-specific payload, recording provenance, and the mandatory uncertainty state.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "epoch.solution-delivery.distinction-record"
            },
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "recordId": {
              "$ref": "#/$defs/DistinctionRecordId"
            },
            "tenantId": {
              "$ref": "#/$defs/TenantId"
            },
            "subject": {
              "$ref": "#/$defs/DistinctionSubject"
            },
            "recordedAt": {
              "$ref": "#/$defs/Timestamp"
            },
            "recordedBy": {
              "$ref": "#/$defs/PrincipalId"
            },
            "uncertainty": {
              "$ref": "#/$defs/UncertaintyState"
            },
            "kind": {
              "type": "string",
              "const": "prediction"
            },
            "measure": {
              "$ref": "#/$defs/Measure"
            },
            "payload": {
              "$ref": "#/$defs/PredictionPayload"
            }
          },
          "required": [
            "schema",
            "schemaVersion",
            "recordId",
            "tenantId",
            "subject",
            "recordedAt",
            "recordedBy",
            "uncertainty",
            "kind",
            "measure",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "epoch.solution-delivery.distinction-record"
            },
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "recordId": {
              "$ref": "#/$defs/DistinctionRecordId"
            },
