{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AcquisitionLine",
  "$defs": {
    "AcquisitionLine": {
      "readOnly": true,
      "title": "AcquisitionLine",
      "description": "One acquisition line: description, quantity+unit, optional solution-line link, and an optional opaque external-party reference (never a vendor name).",
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quantity": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/UnitLabel"
        },
        "solutionLineId": {
          "type": "string",
          "pattern": "^line:[a-z0-9][a-z0-9-]{0,62}$"
        },
        "externalPartyRef": {
          "$ref": "#/$defs/OpaqueReference"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    },
    "UnitLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "title": "UnitLabel",
      "description": "Unit-of-measure label (1-32 characters, provider-neutral)."
    },
    "OpaqueReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "OpaqueReference",
      "description": "Opaque, bounded, provider-neutral reference string owned by its producing system."
    }
  },
  "$id": "urn:epoch:solution-delivery:acquisition-line:1.0.0"
}
