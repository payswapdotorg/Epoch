{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GateId",
  "$defs": {
    "GateId": {
      "type": "string",
      "pattern": "^gate:[a-z0-9][a-z0-9-]{0,62}$",
