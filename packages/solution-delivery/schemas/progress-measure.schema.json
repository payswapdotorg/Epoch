{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProgressMeasure",
  "$defs": {
    "ProgressMeasure": {
      "readOnly": true,
      "title": "ProgressMeasure",
      "description": "A progress measure: a completion fraction between 0 and 1.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "progress"
        },
        "fraction": {
          "$ref": "#/$defs/ProgressFraction"
        }
      },
      "required": [
        "kind",
        "fraction"
      ],
      "additionalProperties": false
    },
    "ProgressFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "title": "ProgressFraction",
      "description": "Progress fraction between 0 and 1 inclusive."
    }
  },
  "$id": "urn:epoch:solution-delivery:progress-measure:1.0.0"
}
