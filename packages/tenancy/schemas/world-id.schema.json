{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/WorldId",
  "$defs": {
    "WorldId": {
      "type": "string",
      "pattern": "^world:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "WorldId",
      "description": "Opaque world identity: \"world:\" followed by a lowercase slug."
    }
  },
  "$id": "urn:epoch:tenancy:world-id:1.0.0"
}
