{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:epoch:provenance:entity",
  "$defs": {
    "urn:epoch:provenance:entity": {
      "readOnly": true,
      "title": "ProvenanceEntity",
      "description": "A durable thing an activity used or generated; carries an exact content digest when content-addressed.",
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entityKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "digest": {
          "$ref": "#/$defs/urn:epoch:provenance:sha256-digest"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "entityId",
        "entityKind"
      ],
      "additionalProperties": false
    },
    "urn:epoch:provenance:sha256-digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:provenance:provenance-entity:1.0.0"
}
