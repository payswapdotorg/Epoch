{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/VarianceConfidence",
  "$defs": {
    "VarianceConfidence": {
      "readOnly": true,
      "title": "VarianceConfidence",
      "description": "The confidence carried on one variance record: acquisition method (stated/measured/estimated/derived/imported), a 0..1 value, optional interval and rationale (the W006-shaped grammar).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "stated",
            "measured",
            "estimated",
            "derived",
            "imported"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interval": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "low",
            "high"
          ],
          "additionalProperties": false
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:variance:variance-confidence:1.0.0"
}
