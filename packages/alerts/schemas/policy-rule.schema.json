{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PolicyRule",
  "$defs": {
    "PolicyRule": {
      "readOnly": true,
      "title": "PolicyRule",
      "description": "One escalation-policy rule: the finding-class token (optionally scoped to one finding-status driver), the mapped severity, and the escalation path.",
      "type": "object",
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/PolicyRuleId"
        },
        "findingClass": {
          "$ref": "#/$defs/FindingClassToken"
        },
        "findingStatus": {
          "type": "string",
          "enum": [
            "due",
            "drifted",
            "late",
            "blocked"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "major",
            "critical"
          ]
        },
        "escalation": {
          "$ref": "#/$defs/EscalationPath"
        }
      },
      "required": [
        "ruleId",
        "findingClass",
        "severity",
        "escalation"
      ],
      "additionalProperties": false
    },
    "PolicyRuleId": {
      "type": "string",
      "pattern": "^rule:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "PolicyRuleId",
      "description": "Opaque escalation-policy rule identity: \"rule:<slug>\"."
    },
    "FindingClassToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "title": "FindingClassToken",
      "description": "A neutral finding-class token: kebab-case, bounded (the closed vocabulary is @epoch/supervision's)."
    },
    "EscalationPath": {
      "readOnly": true,
      "title": "EscalationPath",
      "description": "The escalation path of one policy rule: the notify targets, the escalation delay (seconds), the re-notify cadence (seconds), and the next escalation tier.",
      "type": "object",
      "properties": {
        "notify": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotificationTarget"
          }
        },
        "escalationDelaySeconds": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "reNotifyCadenceSeconds": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "escalateTo": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotificationTarget"
          }
        }
      },
      "required": [
        "notify",
        "escalationDelaySeconds",
        "reNotifyCadenceSeconds",
        "escalateTo"
      ],
      "additionalProperties": false
    },
    "NotificationTarget": {
      "readOnly": true,
      "title": "NotificationTarget",
      "description": "One notification target: a closed neutral kind (role, principal, channel) plus an opaque reference — never a provider identity.",
      "type": "object",
      "properties": {
        "targetKind": {
          "type": "string",
          "enum": [
            "role",
            "principal",
            "channel"
          ]
        },
        "targetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "targetKind",
        "targetRef"
      ],
      "additionalProperties": false
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "NonNegativeDecimal",
      "description": "Non-negative decimal amount as a canonical string (digest-safe, no exponent form)."
    }
  },
  "$id": "urn:epoch:alerts:policy-rule:1.0.0"
}
