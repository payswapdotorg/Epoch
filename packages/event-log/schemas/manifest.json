{
  "contract": "epoch/event-log",
  "contractVersion": "1.0.0",
  "recordVersion": 1,
  "description": "Typed, versioned, provider-neutral Event Log contract surface (W010): the authoritative append-only change history as totally-ordered per-stream typed events with actor/tenant scoping, causal references, payload discriminators and content digests. JSON Schema projection under schemas/; runtime validators in @epoch/event-log.",
  "dataTypes": [
    "ActionLifecycleEventData",
    "CausalEventReference",
    "EventActor",
    "EventData",
    "EventKindDiscriminator",
    "EventLogIssue",
    "EventLogRecordVersion",
    "EventLogSnapshot",
