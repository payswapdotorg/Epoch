    "EventStreamId",
    "EventSubject",
    "EventTenantId",
    "Sha256Digest",
    "StreamInfo",
    "WorldSubjectsEventData"
  ],
  "jsonSchemaFidelity": "structural-only: zod refinements (intra-stream causal parents, kernel payload contracts for reserved namespaces, snapshot ordering/projection consistency) are enforced by the runtime validators in @epoch/event-log and are not represented in the JSON Schema files",
