{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ExperienceGraphReference",
  "$defs": {
    "ExperienceGraphReference": {
      "readOnly": true,
      "title": "ExperienceGraphReference",
      "description": "Reference to the W011 Experience Graph that is an Engineering Moment visual state (digest only — never embedded).",
      "type": "object",
      "properties": {
        "graphKind": {
          "$ref": "#/$defs/MomentExperienceGraphKind"
        },
        "graphDigest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "graphKind",
        "graphDigest"
      ],
      "additionalProperties": false
    },
    "MomentExperienceGraphKind": {
      "type": "string",
      "enum": [
        "2d",
        "3d",
        "animation",
        "narrative",
        "timeline-replay",
        "presence",
        "controls"
      ],
      "title": "MomentExperienceGraphKind",
      "description": "The W011 Experience Graph kind of a moment visual state (W011 vocabulary)."
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:ai-experience:experience-graph-reference:1.0.0"
}
