{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ActionProposalTarget",
  "$defs": {
    "ActionProposalTarget": {
      "readOnly": true,
      "title": "ActionProposalTarget",
      "description": "Exact-revision action-proposal reference (W003 ProposalReference shape): message id plus the SHA-256 digest of the canonical proposal.",
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "canonicalDigest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "proposalId",
        "canonicalDigest"
      ],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    }
  },
  "$id": "urn:epoch:ai-experience:action-proposal-target:1.0.0"
}
