{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/InteractionIntent",
  "$defs": {
    "InteractionIntent": {
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "annotate"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ProjectedReference"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "data": {
              "readOnly": true,
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              }
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approve"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ActionProposalTarget"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "from": {
              "$ref": "#/$defs/TimelinePosition"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "compare"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "targets": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ProjectedReference"
                },
                {
                  "$ref": "#/$defs/ProjectedReference"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "targets"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "execute"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ActionProposalTarget"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filter"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "criteria": {
              "readOnly": true,
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              }
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "criteria"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "follow-agent"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "agentId": {
              "$ref": "#/$defs/AiAgentId"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "agentId"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inspect"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ProjectedReference"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pause"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "kind",
            "intentVersion"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "query"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "replay"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "position": {
              "$ref": "#/$defs/TimelinePosition"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "position"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reject"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ActionProposalTarget"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "release-control"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "kind",
            "intentVersion"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "kind",
            "intentVersion"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "target": {
              "$ref": "#/$defs/ProjectedReference"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "take-control"
            },
            "intentVersion": {
              "type": "number",
              "const": 1
            },
            "authority": {
              "$ref": "#/$defs/ControlAuthority"
            }
          },
          "required": [
            "kind",
            "intentVersion",
            "authority"
          ],
          "additionalProperties": false
        }
      ],
      "title": "InteractionIntent",
      "description": "The typed interaction-intent union: sixteen versioned members, one per admitted Universal-interaction subset. Agents emit typed intents, never executable UI code."
    },
    "ProjectedReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectedWorldEntityRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldRelationRef"
        },
        {
          "$ref": "#/$defs/ProjectedWorldEventRef"
        },
        {
          "$ref": "#/$defs/ProjectedAgentRef"
        },
        {
          "$ref": "#/$defs/ProjectedEvidenceRef"
        },
        {
          "$ref": "#/$defs/ProjectedCapabilityRef"
        }
      ],
      "title": "ProjectedReference",
      "description": "Opaque, tenant-scoped, exact-revision reference to projected kernel state; never an embedded kernel object."
    },
    "ProjectedWorldEntityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-entity"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "entityId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:entity-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "entityId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEntityRef",
      "description": "Exact-revision reference to a materialized world-model entity (W002 grammar; digest of its canonical JSON)."
    },
    "OpaqueScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "OpaqueScopeId",
      "description": "Opaque scoping identifier (tenant/workspace/project/participant); bounded, neutral charset."
    },
    "urn:epoch:contracts:world:entity-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "EntityId",
      "description": "Opaque entity identity (graph node), caller-assigned."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Hex",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "ProjectedWorldRelationRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-relation"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "relationId": {
          "$ref": "#/$defs/WorldRelationId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "relationId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldRelationRef",
      "description": "Exact-revision reference to a materialized world-model relation (W002 grammar; digest of its canonical JSON)."
    },
    "WorldRelationId": {
      "type": "string",
      "pattern": "^rel-[0-9a-f]{64}$",
      "title": "WorldRelationId",
      "description": "World-model relation identity: rel-<sha256-of-key> (owned by @epoch/world-model)."
    },
    "ProjectedWorldEventRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "world-event"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "eventId": {
          "$ref": "#/$defs/urn:epoch:contracts:world:event-id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "eventId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedWorldEventRef",
      "description": "Exact-revision reference to a world-model event (W002 grammar; digest of its canonical JSON)."
    },
    "urn:epoch:contracts:world:event-id": {
      "type": "string",
      "pattern": "^evt-[0-9]+$",
      "title": "EventId"
    },
    "ProjectedAgentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "agentId",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedAgentRef",
      "description": "Exact-revision reference to a registered agent (W003 grammar; digest of its registration canonical JSON)."
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AgentId",
      "description": "Registered agent identifier: \"agent:\" followed by a lowercase slug."
    },
    "ProjectedEvidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "evidence-record"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "recordDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "recordDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedEvidenceRef",
      "description": "Reference to an evidence record by its content-addressed identity (W006: the SHA-256 digest is the id)."
    },
    "ProjectedCapabilityRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "capability"
        },
        "tenantId": {
          "$ref": "#/$defs/OpaqueScopeId"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "capabilityId",
        "capabilityVersion",
        "contentDigest"
      ],
      "additionalProperties": false,
      "title": "ProjectedCapabilityRef",
      "description": "Exact-revision reference to a registered capability manifest (W007 grammar; digest of its canonical JSON)."
    },
    "JsonValue": {
      "title": "JsonValue",
      "description": "JSON-representable value (finite numbers only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "ActionProposalTarget": {
      "readOnly": true,
      "title": "ActionProposalTarget",
      "description": "Exact-revision action-proposal reference (W003 ProposalReference shape): message id plus the SHA-256 digest of the canonical proposal.",
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "canonicalDigest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "proposalId",
        "canonicalDigest"
      ],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256Digest",
      "description": "Lowercase hexadecimal SHA-256 digest (exactly 64 characters)."
    },
    "TimelinePosition": {
      "readOnly": true,
      "title": "TimelinePosition",
      "description": "One timeline/replay position: a W010 event-log stream coordinate (inclusive last-applied sequence; 0 denotes the stream start).",
      "type": "object",
      "properties": {
        "streamId": {
          "$ref": "#/$defs/EventStreamId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "streamId",
        "sequence"
      ],
      "additionalProperties": false
    },
    "EventStreamId": {
      "type": "string",
      "pattern": "^stream:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "EventStreamId",
      "description": "Opaque event stream identity: the unit of total order; every event in a stream carries a contiguous 1-based sequence."
    },
    "AiAgentId": {
      "type": "string",
      "pattern": "^agent:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AiAgentId",
      "description": "Registered agent identity: \"agent:\" followed by a lowercase slug (W003 grammar)."
    },
    "ControlAuthority": {
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session-owner"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role-grant"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit-handover"
            },
            "from": {
              "$ref": "#/$defs/AiPrincipalId"
            }
          },
          "required": [
            "kind",
            "from"
          ],
          "additionalProperties": false
        }
      ],
      "title": "ControlAuthority",
      "description": "The authority a takeover claims: session-owner, role-grant, or an explicit handover from the current controller."
    },
    "AiPrincipalId": {
      "type": "string",
      "pattern": "^principal:[a-z0-9][a-z0-9-]{0,62}$",
      "title": "AiPrincipalId",
      "description": "Collaboration participant principal: \"principal:\" followed by a lowercase slug (W009 grammar)."
    }
  },
  "$id": "urn:epoch:ai-experience:interaction-intent:1.0.0"
}
