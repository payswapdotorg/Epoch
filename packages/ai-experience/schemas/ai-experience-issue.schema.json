{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiExperienceIssue",
  "$defs": {
    "AiExperienceIssue": {
      "readOnly": true,
      "title": "AiExperienceIssue",
      "description": "One flattened validation issue: dotted path (\"$\" = root) plus message.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:ai-experience:ai-experience-issue:1.0.0"
}
