{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiSessionScope",
  "$defs": {
    "AiSessionScope": {
      "readOnly": true,
      "title": "AiSessionScope",
      "description": "Optional tenant-hierarchy narrowing of a collaboration session (W009/W010 grammars).",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^workspace:[a-z0-9][a-z0-9-]{0,62}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^project:[a-z0-9][a-z0-9-]{0,62}$"
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "urn:epoch:ai-experience:ai-session-scope:1.0.0"
}
