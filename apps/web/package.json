{
  "name": "@epoch/web",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch web product (W047, ACR-005): the canonical usable Epoch web client. The app layer hosts the Application Gateway transport (every server-facing mutation flows through Gateway envelopes over the frozen @epoch/client-runtime vocabulary \u2014 never kernel internals), projects the World Model, unknowns/evidence, capability discovery, solution decide/approve, Program of Work/BOQ, acquisition, delivery/realization, verification, forecast, marketplace/developer surfaces, the offline queue with idempotent replay, and cross-device handoff. The web app adds no domain model of its own (architecture lock rules 8/16).",
  "epoch": {
    "layer": "app"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/link-cross-harness.mjs && cd ../../qa/cross-platform && eslint . --config eslint.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../qa/cross-platform/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cross:journeys": "vitest run ../../qa/cross-platform/cross-platform.test.ts"
  },
  "dependencies": {
    "@epoch/action-gateway": "workspace:*",
    "@epoch/adapter-s3-object-store": "workspace:*",
    "@epoch/adapter-upstash-redis": "workspace:*",
    "@epoch/agent-protocol": "workspace:*",
    "@epoch/alerts": "workspace:*",
    "@epoch/application-gateway": "workspace:*",
    "@epoch/authentication": "workspace:*",
    "@epoch/authorization": "workspace:*",
    "@epoch/client-runtime": "workspace:*",
    "@epoch/event-log": "workspace:*",
    "@epoch/evidence": "workspace:*",
    "@epoch/identity": "workspace:*",
    "@epoch/object-storage": "workspace:*",
    "@epoch/persistence": "workspace:*",
    "@epoch/policy-contracts": "workspace:*",
    "@epoch/procurement": "workspace:*",
    "@epoch/solution-delivery": "workspace:*",
    "@epoch/supervision": "workspace:*",
    "@epoch/tenancy": "workspace:*",
    "@epoch/world-model": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@epoch/eslint-config": "workspace:*",
    "@epoch/experience-compiler": "workspace:*",
    "@epoch/experience-protocol": "workspace:*",
    "@epoch/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
