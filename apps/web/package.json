{
  "name": "@epoch/web",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch web app shell (W014): the composition layer that hosts projections — navigation frame, tenant/session providers, typed feature mounting points, and App Router wiring. The shell adds no domain model of its own (architecture lock rules 8/16).",
  "epoch": {
    "layer": "app"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@epoch/authorization": "workspace:*",
    "@epoch/eslint-config": "workspace:*",
    "@epoch/experience-compiler": "workspace:*",
    "@epoch/experience-protocol": "workspace:*",
    "@epoch/identity": "workspace:*",
    "@epoch/tenancy": "workspace:*",
    "@epoch/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
