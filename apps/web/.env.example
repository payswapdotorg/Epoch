# Epoch — production environment template (W051, ACR-006)
#
# PLACEHOLDERS ONLY. Real values are deployment secrets and NEVER enter
# the repository: configure them through the deployment platform's
# secure environment (Vercel project environment variables) or the local
# operator environment. Contract: spec/production-environment.md.
#
# Profiles: development (default; fully local) | preview | production
# Production REQUIRES EPOCH_DATABASE_URL + EPOCH_OBJECT_STORE_* (boot
# fails closed without durable bindings).

# --- Deployment profile ---
EPOCH_DEPLOYMENT_PROFILE=development

# --- Persistence (Neon PostgreSQL) ---
# A postgres:// or postgresql:// connection string (Neon URLs carry
# their own sslmode). Server-side only.
EPOCH_DATABASE_URL=

# --- Object storage (Cloudflare R2 / any S3-compatible endpoint) ---
# endpoint example: https://<account-id>.r2.cloudflarestorage.com
EPOCH_OBJECT_STORE_ENDPOINT=
EPOCH_OBJECT_STORE_BUCKET=
EPOCH_OBJECT_STORE_ACCESS_KEY_ID=
EPOCH_OBJECT_STORE_SECRET_ACCESS_KEY=
EPOCH_OBJECT_STORE_REGION=auto

# --- Rate limiting (Upstash Redis REST) ---
# Unset => the in-memory reference limiter (per-instance, surfaced).
EPOCH_RATE_LIMIT_REST_URL=
EPOCH_RATE_LIMIT_REST_TOKEN=
EPOCH_RATE_LIMIT_TIMEOUT_MS=800
EPOCH_RATE_LIMIT_IP_REQUESTS_PER_WINDOW=120
EPOCH_RATE_LIMIT_IP_WINDOW_MS=60000
EPOCH_RATE_LIMIT_TENANT_REQUESTS_PER_WINDOW=600
EPOCH_RATE_LIMIT_TENANT_WINDOW_MS=60000
EPOCH_RATE_LIMIT_OPERATION_REQUESTS_PER_WINDOW=120
EPOCH_RATE_LIMIT_OPERATION_WINDOW_MS=60000
EPOCH_RATE_LIMIT_SESSION_REQUESTS_PER_WINDOW=300
EPOCH_RATE_LIMIT_SESSION_WINDOW_MS=60000

# --- External acquisition (Apify) ---
# Unset => external discovery disabled (graceful degradation).
EPOCH_APIFY_TOKEN=
EPOCH_APIFY_ACTOR_ID=
EPOCH_APIFY_MAX_RUNS_PER_DAY=1
