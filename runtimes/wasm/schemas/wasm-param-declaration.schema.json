{
  "title": "WasmParamDeclaration",
  "description": "Wasm component parameter: kebab name plus WIT primitive type.",
  "type": "object",
  "properties": {
    "name": {
      "title": "name",
      "description": "Kebab-case parameter name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "type": {
      "title": "WasmValueType",
      "description": "WIT primitive value type: bool, char, f32, f64, s8..s64, string, or u8..u64.",
      "type": "string",
      "enum": [
        "bool",
        "char",
        "f32",
        "f64",
        "s16",
        "s32",
        "s64",
        "s8",
        "string",
        "u16",
        "u32",
        "u64",
        "u8"
      ]
    }
  },
  "required": [
    "name",
    "type"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epoch:wasm-layout:wasm-param-declaration:1.0.0"
}
